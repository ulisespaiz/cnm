---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';
import { getServices, serviceUrl } from '../../lib/content';
import { breadcrumbs } from '../../lib/schema';

const services = await getServices();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
];
---

<Base
  title="Machining, Cutting & Fabrication Services in Salinas, CA"
  description={`Water-jet and laser cutting, CNC machining, welding, metal work and custom fabrication from ${site.legalName} in ${site.address.city}, CA.`}
  jsonLd={[breadcrumbs(crumbs)]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Our Services</p>
      <h1>Everything we do, <span class="mark">done right</span></h1>
      <p class="lead">
        At {site.legalName}, we offer a range of tailored services designed to meet your unique needs. Our commitment
        to quality, innovation, and client satisfaction sets us apart — helping you achieve lasting success.
      </p>

      <div class="service-list">
        {services.map((s, i) => (
          <a class="service-row" href={serviceUrl(s)}>
            {s.data.image && (
              <Image src={s.data.image} alt={s.data.imageAlt ?? s.data.title} widths={[400, 700]} sizes="(min-width: 900px) 420px, 100vw" loading={i === 0 ? 'eager' : 'lazy'} />
            )}
            <div class="service-row__body">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h2>{s.data.title}</h2>
              <p class="muted">{s.data.summary}</p>
              <ul class="ticks">
                {s.data.capabilities.map((c) => <li>{c.name}</li>)}
              </ul>
              <span class="more">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand heading="Ready to start your project?" text="Our team is ready to provide expert solutions that ensure your goals are met efficiently and effectively." />
</Base>

<style>
  .service-list {
    display: grid;
    gap: 20px;
    margin-top: 36px;
  }

  .service-row {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s;
  }

  .service-row:hover {
    box-shadow: var(--shadow);
  }

  @media (min-width: 900px) {
    .service-row {
      grid-template-columns: 420px 1fr;
    }
  }

  .service-row img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .service-row__body {
    padding: 24px;
  }

  .service-row h2 {
    font-size: clamp(1.4rem, 2vw + 0.8rem, 1.9rem);
  }

  .num {
    display: inline-block;
    margin-bottom: 8px;
    font-weight: 700;
    color: var(--color-accent);
  }

  .more {
    font-weight: 700;
    color: var(--color-primary);
  }
</style>
