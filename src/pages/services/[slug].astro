---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { site } from '../../config/site';
import { getEquipment, getServices, serviceHeading, serviceTeaser, serviceUrl } from '../../lib/content';
import { areaServed, breadcrumbs, faqPage } from '../../lib/schema';

export const getStaticPaths = (async () => {
  const services = await getServices();
  const equipment = await getEquipment();
  return services.map((service) => ({
    params: { slug: service.id },
    // The machines whose `service` (src/content/equipment.json) is this one: the page links to each on /our-machinery/.
    props: { service, services, machines: equipment.filter((m) => m.data.service?.id === service.id) },
  }));
}) satisfies GetStaticPaths;

const { service, services, machines } = Astro.props;
const { data } = service;
const { Content } = await render(service);
// The summary is the page's lead paragraph; the Markdown body holds only what it adds (it may be empty).
const hasBody = Boolean(service.body?.trim());
const url = serviceUrl(service);
// h1 and on-page headings ("CNC Machining"); breadcrumbs, cards and JSON-LD keep data.title ("Machining").
const heading = serviceHeading(service);
// The quote form reads ?service=<id> and #details is its details form (src/pages/quote/index.astro).
const quoteUrl = `/quote/?service=${service.id}#details`;
const others = services.filter((s) => s.id !== service.id);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: data.title, path: url },
];

// Link preview: the hero photo cropped to the 1200x630 share size (the size of public/og.jpg,
// used when the service has no photo), as a JPEG.
const share = data.image ? await getImage({ src: data.image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 }) : undefined;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: data.title,
  description: data.summary,
  url: new URL(url, site.url).href,
  provider: { '@id': new URL('/#business', site.url).href },
  serviceType: data.title,
  areaServed: areaServed(),
  ...(data.capabilities.length
    ? {
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: data.title,
          itemListElement: data.capabilities.map((c) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: c.name, description: c.text },
          })),
        },
      }
    : {}),
};
---

<Base
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.summary}
  image={share?.src}
  imageAlt={share ? (data.imageAlt ?? data.title) : undefined}
  imageWidth={1200}
  imageHeight={630}
  jsonLd={[breadcrumbs(crumbs), serviceSchema, ...(data.faqs.length ? [faqPage(data.faqs)] : [])]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="service">
        <div>
          <p class="eyebrow">Services · {site.address.city}, {site.address.region}</p>
          <h1>{heading}</h1>
          <p class="lead">{data.summary}</p>
          {data.image && (
            <Image class="service__image" src={data.image} alt={data.imageAlt ?? data.title} widths={[480, 680, 800, 1100]} sizes="(min-width: 900px) 700px, calc(100vw - 32px)" loading="eager" fetchpriority="high" />
          )}
          {hasBody && (
            <div class="prose">
              <Content />
            </div>
          )}

          {data.capabilities.length > 0 && (
            <>
              <h2 class="service__h2">Capabilities</h2>
              <ul class="capabilities">
                {data.capabilities.map((c) => (
                  <li>
                    <h3>{c.name}</h3>
                    <p>{c.text}</p>
                  </li>
                ))}
              </ul>
            </>
          )}

          {data.materials.length > 0 && (
            <>
              <h2 class="service__h2">{data.materialsLabel}</h2>
              <ul class="chips">
                {data.materials.map((m) => <li>{m}</li>)}
              </ul>
            </>
          )}

          {machines.length > 0 && (
            <>
              <h2 class="service__h2">Machines we use</h2>
              <ul class="chips chips--links">
                {machines.map((m) => <li><a href={`/our-machinery/#${m.id}`}>{m.data.name}</a></li>)}
              </ul>
            </>
          )}

          <ul class="service__more">
            <li><a href="/our-machinery/">{machines.length > 0 ? 'See all our machinery' : 'See our machinery'}</a></li>
            <li><a href="/industries/food-processing-agriculture/">How we serve food processing &amp; agriculture</a></li>
          </ul>
        </div>

        <aside class="service__quote" aria-labelledby="service-quote-title">
          <h2 class="h3" id="service-quote-title">Have a job for us?</h2>
          <p class="muted">Tell us about the part or project, or call the shop.</p>
          <div class="service__actions">
            <a class="btn btn--red" href={quoteUrl}>Request a quote</a>
            <a class="btn btn--outline" href={`tel:${site.phoneE164}`}>Call {site.phone}</a>
          </div>
          <p class="service__reply">{site.replyTime}.</p>
          <p class="muted service__areas">Based in {site.address.city}. <a href="/service-areas/">See the areas we serve</a></p>
        </aside>
      </div>
    </div>
  </section>

  {data.faqs.length > 0 && (
    <section class="section">
      <div class="container faq-wrap">
        <h2>{heading}: common questions</h2>
        {data.faqs.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  {others.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <h2>More services</h2>
        <div class="grid">
          {others.map((s) => (
            <a class="card" href={serviceUrl(s)}>
              <div class="card__body">
                <h3>{s.data.title}</h3>
                <p class="muted">{serviceTeaser(s)}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .faq-wrap {
    max-width: 820px;
  }

  .faq {
    margin-bottom: 12px;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .faq summary {
    min-height: 56px;
    padding: 14px 20px;
    font-weight: 600;
    cursor: pointer;
  }

  .faq p {
    margin: 0;
    padding: 0 20px 18px;
    color: var(--color-muted);
  }

  .service {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 900px) {
    .service {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }

    .service__quote {
      position: sticky;
      top: 88px;
    }
  }

  .service__quote {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow);
  }

  /* Quote and Call side by side while both fit on one line each; stacked, full width, when they do not. */
  .service__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .service__actions .btn {
    flex: 1 1 auto;
    padding-inline: 14px;
    white-space: nowrap;
  }

  .service__reply {
    margin: 14px 0 12px;
    font-weight: 600;
  }

  .service__areas {
    margin-bottom: 0;
    font-size: 0.9rem;
  }

  .service__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 24px;
  }

  .service .lead {
    margin-bottom: 24px;
  }

  .h3 {
    font-size: 1.2rem;
  }

  /* Section headings inside the service column: h2 in the outline, sized as sub-headings (as .service .prose h2 is) */
  .service__h2 {
    margin-top: 1.5em;
    font-size: 1.5rem;
  }

  .capabilities {
    display: grid;
    gap: 16px;
    padding: 0;
    margin: 0 0 24px;
    list-style: none;
  }

  .capabilities h3 {
    font-size: 1.15rem;
  }

  @media (min-width: 640px) {
    .capabilities {
      grid-template-columns: 1fr 1fr;
    }
  }

  .capabilities li {
    padding: 16px;
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .capabilities p {
    margin: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 6px 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.95rem;
  }

  /* Chips that are links (the machines): the whole chip is the tap target, 44px tall */
  .chips--links li {
    padding: 0;
  }

  .chips--links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 6px 16px;
    font-weight: 600;
    text-decoration: none;
  }

  .chips--links a:hover {
    text-decoration: underline;
  }

  .service__more {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 24px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .service__more a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
</style>
