---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AddToQuote from '../../components/AddToQuote.astro';
import { site } from '../../config/site';
import { getServices, serviceUrl } from '../../lib/content';
import { breadcrumbs, faqPage } from '../../lib/schema';

export const getStaticPaths = (async () => {
  const services = await getServices();
  return services.map((service) => ({ params: { slug: service.id }, props: { service, services } }));
}) satisfies GetStaticPaths;

const { service, services } = Astro.props;
const { data } = service;
const { Content } = await render(service);
const url = serviceUrl(service);
const others = services.filter((s) => s.id !== service.id);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services/' },
  { name: data.title, path: url },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: data.title,
  description: data.summary,
  url: new URL(url, site.url).href,
  provider: { '@id': new URL('/#business', site.url).href },
  serviceType: data.title,
  areaServed: { '@type': 'AdministrativeArea', name: 'Monterey County, CA' },
  ...(data.capabilities.length
    ? {
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: data.title,
          itemListElement: data.capabilities.map((c) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: c.name, description: c.text },
          })),
        },
      }
    : {}),
};
---

<Base
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.summary}
  jsonLd={[breadcrumbs(crumbs), serviceSchema, ...(data.faqs.length ? [faqPage(data.faqs)] : [])]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="service">
        <div>
          <p class="eyebrow">Services</p>
          <h1>{data.title}</h1>
          {data.image && (
            <Image class="service__image" src={data.image} alt={data.imageAlt ?? data.title} widths={[480, 800, 1100]} sizes="(min-width: 900px) 700px, 100vw" loading="eager" fetchpriority="high" />
          )}
          <div class="prose">
            <Content />
          </div>

          {data.capabilities.length > 0 && (
            <ul class="capabilities">
              {data.capabilities.map((c) => (
                <li>
                  <h2 class="h3">{c.name}</h2>
                  <p>{c.text}</p>
                </li>
              ))}
            </ul>
          )}

          {data.materials.length > 0 && (
            <>
              <h2 class="h3">{data.materialsLabel}</h2>
              <ul class="chips">
                {data.materials.map((m) => <li>{m}</li>)}
              </ul>
            </>
          )}

        </div>

        <aside class="service__quote">
          <h2 class="h3">Request a quote</h2>
          <p class="muted">Add this service to your quote list, then send the details.</p>
          <AddToQuote id={`service:${service.id}`} title={data.title} url={url} label="Add to Quote" />
          <p class="muted service__call">Or call <a href={`tel:${site.phoneE164}`}>{site.phone}</a></p>
        </aside>
      </div>
    </div>
  </section>

  {data.faqs.length > 0 && (
    <section class="section">
      <div class="container faq-wrap">
        <h2>{data.title}: common questions</h2>
        {data.faqs.map((f, i) => (
          <details class="faq" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}

  {others.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <h2>More services</h2>
        <div class="grid">
          {others.map((s) => (
            <a class="card" href={serviceUrl(s)}>
              <div class="card__body">
                <h3>{s.data.title}</h3>
                <p class="muted">{s.data.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .faq-wrap {
    max-width: 820px;
  }

  .faq {
    margin-bottom: 12px;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .faq summary {
    min-height: 56px;
    padding: 14px 20px;
    font-weight: 600;
    cursor: pointer;
  }

  .faq p {
    margin: 0;
    padding: 0 20px 18px;
    color: var(--color-muted);
  }

  .service {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 900px) {
    .service {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }

    .service__quote {
      position: sticky;
      top: 88px;
    }
  }

  .service__quote {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow);
  }

  .service__call {
    margin-top: 12px;
  }

  .service__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 24px;
  }

  .h3 {
    font-size: 1.2rem;
  }

  .capabilities {
    display: grid;
    gap: 16px;
    padding: 0;
    margin: 24px 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .capabilities {
      grid-template-columns: 1fr 1fr;
    }
  }

  .capabilities li {
    padding: 16px;
    border-left: 4px solid var(--color-accent);
    background: var(--color-surface);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .capabilities p {
    margin: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .chips li {
    padding: 6px 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.95rem;
  }
</style>
