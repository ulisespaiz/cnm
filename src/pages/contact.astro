---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '../config/site';
import { breadcrumbs } from '../lib/schema';
import { hoursRows, hoursSentence } from '../lib/hours';
import office from '../assets/site/front-office-cnm.jpeg';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
const hours = hoursRows();
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${site.legalName}, ${site.address.street}, ${site.address.city}, ${site.address.region} ${site.address.postalCode}`,
)}`;
---

<Base
  title="Contact Us"
  description={`Call ${site.phone} or visit ${site.legalName}, ${site.address.street}, ${site.address.city}, CA. ${hoursSentence()}.`}
  jsonLd={[breadcrumbs(crumbs)]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Contact Us</p>
      <h1>Let's talk about your <span class="mark">project</span></h1>
      <p class="lead">
        Reach out for quotes, questions, or to discuss your custom machining needs. {site.replyTime}, and you can call
        us during shop hours.
      </p>

      <div class="contact">
        <div class="contact__details">
          <Image src={office} alt={`${site.name} front office`} widths={[480, 800]} sizes="(min-width: 900px) 440px, 100vw" loading="eager" />
          <dl>
            <div>
              <dt>Phone</dt>
              <dd><a href={`tel:${site.phoneE164}`}>{site.phone}</a></dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
            <div>
              <dt>Address</dt>
              <dd>
                <a href={mapUrl} rel="noopener">{site.address.street}, {`${site.address.city}, ${site.address.region} ${site.address.postalCode}`}</a>
              </dd>
            </div>
            <div>
              <dt>Business hours</dt>
              <dd>
                <ul class="hours">
                  {hours.map((r) => (
                    <li><span>{r.label}</span><span>{r.value}</span></li>
                  ))}
                </ul>
              </dd>
            </div>
          </dl>
          <a class="btn btn--outline btn--block" href={mapUrl} rel="noopener">Get directions</a>
        </div>
        <div class="contact__form">
          <h2 class="h3">Send us a message</h2>
          <QuoteForm kind="contact" />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    gap: 24px;
    margin-top: 32px;
  }

  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 1fr 1.3fr;
      align-items: start;
    }
  }

  .contact__details,
  .contact__form {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .contact__details img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: calc(var(--radius) - 4px);
  }

  dl {
    display: grid;
    gap: 16px;
    margin: 20px 0;
  }

  dt {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  dd {
    margin: 2px 0 0;
    font-weight: 600;
  }

  /* Phone, email and address are tap targets: 44px minimum */
  dd > a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .hours {
    display: grid;
    gap: 4px;
    max-width: 320px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hours li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .hours li span:last-child {
    font-variant-numeric: tabular-nums;
  }

  .h3 {
    font-size: 1.4rem;
  }
</style>
