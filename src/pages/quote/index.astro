---
// /quote/: the items card (QuoteItems) and the details form (QuoteForm) side by side, the part request below.
// public/quote-early.js (a classic script from 'self': the CSP allows no inline ones) flags a returning
// visitor's saved list before first paint, so the empty state never flashes.
import Base from '../../layouts/Base.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import QuoteItems from '../../components/QuoteItems.astro';
import PartRequestForm from '../../components/PartRequestForm.astro';
import { site } from '../../config/site';
---

<Base
  title="Request a Quote"
  description={site.store.enabled
    ? "Send us your list of parts and project details and we'll email you a detailed quote."
    : "Tell us about your part or project and we'll email you a detailed quote."}
  noindex
  hideMobileBar
>
  <script is:inline src="/quote-early.js" slot="head"></script>
  <section class="section quote-page" data-shop={site.store.enabled ? undefined : 'off'}>
    <div class="container">
      <p class="eyebrow">C&amp;M MACHINE SHOP</p>
      <h1>Request a Quote</h1>
      <p class="lead">Tell us how to reach you and what you need, and we'll get back to you with pricing as soon as possible.</p>

      <div class="qp">
        <div class="qp__items">
          <QuoteItems />
        </div>

        <section class="qcard qp__form" aria-labelledby="info-title">
          <header class="qcard__head">
            <h2 id="info-title" class="qcard__title">Your Information</h2>
          </header>
          <div class="qcard__body">
            <QuoteForm kind="quote" />
          </div>
        </section>
      </div>

      <details class="qp__request" id="cant-find">
        <summary>
          <span>{site.store.enabled ? "Can't find your part? Send us the part number" : 'Need a replacement part? Send us the part number'}</span>
          <svg class="qp__chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4.5l4 4 4-4" /></svg>
        </summary>
        <PartRequestForm compact urlPrefill={false} />
      </details>
      {site.store.enabled && <p class="muted qp__legal">{site.store.disclaimer}</p>}
      <p class="muted qp__call">Questions? Call <a href={`tel:${site.phoneE164}`}>{site.phone}</a>.</p>
    </div>
  </section>
</Base>

<script>
  import '../../scripts/quote-page';
</script>

<style>
  .quote-page .eyebrow {
    margin-bottom: 14px;
    background: transparent;
    padding-inline: 0;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }

  .quote-page h1 {
    font-size: clamp(2.25rem, 5vw + 0.5rem, 3.5rem);
    margin-bottom: 12px;
  }

  .quote-page .lead {
    margin-bottom: 28px;
  }

  .qp {
    display: grid;
    gap: 20px;
    align-items: start;
  }

  /* The list first, then the form: stacked on phones, side by side from 900px. The columns follow the
     DOM, so Tab order and reading order match what is on screen. */
  .qp__items {
    grid-area: items;
  }

  .qp__form {
    grid-area: form;
  }

  .qp {
    grid-template-areas: 'items' 'form';
  }

  @media (min-width: 900px) {
    .qp {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
      grid-template-areas: 'items form';
      gap: 32px;
    }
  }

  .qcard {
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .qcard__head {
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-border);
  }

  .qcard__title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  .qcard__title::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: #000;
  }

  .qcard__body {
    padding: 22px 20px 20px;
  }

  /* "Continue: your details" jumps here. html's scroll-padding-top (80px) already clears the sticky
     header; the margin adds a little air, 88px from the top edge in all. */
  #info-title {
    scroll-margin-top: 8px;
  }

  .qp__request {
    margin-top: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  /* The chevron shows that it opens (shop on or off) */
  .qp__request summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: var(--tap);
    padding: 14px 16px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .qp__request summary::-webkit-details-marker {
    display: none;
  }

  .qp__chev {
    flex: none;
    transition: transform 0.15s;
  }

  .qp__request[open] .qp__chev {
    transform: rotate(180deg);
  }

  .qp__request :global(.part-request) {
    margin: 0 12px 12px;
    border: 0;
    padding: 8px 4px 4px;
  }

  .qp__legal {
    margin: 16px 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .qp__call {
    margin-top: 16px;
    text-align: center;
  }
</style>

<style is:global>
  /* No bottom bar on this page, so toasts sit near the bottom edge */
  body.no-mobile-bar .toast-region {
    bottom: calc(16px + env(safe-area-inset-bottom));
  }
</style>
