---
import Base from '../../layouts/Base.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import QuoteItems from '../../components/QuoteItems.astro';
import PartRequestForm from '../../components/PartRequestForm.astro';
import { site } from '../../config/site';
---

<Base
  title="Request a Quote"
  description="Send us your list of parts and project details and we'll email you a detailed quote."
  noindex
  hideMobileBar
>
  <section class="section quote-page">
    <div class="container">
      <p class="eyebrow">C&amp;M MACHINE SHOP</p>
      <h1>Request a Quote</h1>
      <p class="lead">Tell us how to reach you and what you need, and we'll get back to you with pricing as soon as possible.</p>

      <div class="qp">
        <div class="qp__items">
          <QuoteItems />
        </div>

        <section class="qcard qp__form" aria-labelledby="info-title">
          <header class="qcard__head">
            <h2 id="info-title" class="qcard__title">Your Information</h2>
          </header>
          <div class="qcard__body">
            <QuoteForm kind="quote" />
          </div>
        </section>
      </div>

      <details class="qp__request" id="cant-find">
        <summary>Can't find your part? Send us the part number</summary>
        <PartRequestForm compact urlPrefill={false} />
      </details>
      <p class="muted qp__call">Questions? Call <a href={`tel:${site.phoneE164}`}>{site.phone}</a>.</p>
    </div>
  </section>
</Base>

<script>
  import '../../scripts/quote-page';
</script>

<style>
  .quote-page .eyebrow {
    margin-bottom: 14px;
    background: transparent;
    padding-inline: 0;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }

  .quote-page h1 {
    font-size: clamp(2.25rem, 5vw + 0.5rem, 3.5rem);
    margin-bottom: 12px;
  }

  .quote-page .lead {
    margin-bottom: 28px;
  }

  .qp {
    display: grid;
    gap: 20px;
    align-items: start;
  }

  /* Phones: the list first, then the form. Desktop: form left, list right. */
  .qp__items {
    grid-area: items;
  }

  .qp__form {
    grid-area: form;
  }

  .qp {
    grid-template-areas: 'items' 'form';
  }

  @media (min-width: 900px) {
    .qp {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      grid-template-areas: 'form items';
      gap: 32px;
    }
  }

  .qcard {
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .qcard__head {
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-border);
  }

  .qcard__title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  .qcard__title::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: #000;
  }

  .qcard__body {
    padding: 22px 20px 20px;
  }

  .qp__request {
    margin-top: 24px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .qp__request summary {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 16px;
    font-weight: 600;
    cursor: pointer;
  }

  .qp__request :global(.part-request) {
    margin: 0 12px 12px;
    border: 0;
    padding: 8px 4px 4px;
  }

  .qp__call {
    margin-top: 16px;
    text-align: center;
  }
</style>

<style is:global>
  /* No bottom bar on this page, so toasts sit near the bottom edge */
  body.no-mobile-bar .toast-region {
    bottom: calc(16px + env(safe-area-inset-bottom));
  }
</style>
