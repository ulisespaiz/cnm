---
// /quote/thanks/: where a quote request lands (a JavaScript send goes here itself; a send without JavaScript is
// redirected here by Web3Forms). The contact form has its own page, /contact/thanks/.
import ThanksPage from '../../components/ThanksPage.astro';
import { site } from '../../config/site';
---

<ThanksPage
  title="Request Received"
  description={`Your request reached ${site.name}. We send you a detailed quote.`}
  heading="Thanks, we got your request."
>
  <Fragment slot="lead">
    {site.replyTime}.
    <span data-ref-hint hidden>Keep your reference handy if you contact us about this request.</span>
  </Fragment>

  <Fragment slot="next">
    <ol class="steps">
      <li>We review your {site.store.enabled ? 'list' : 'request'} and any notes you sent.</li>
      <li>We send you a detailed quote.</li>
      <li>
        Questions in the meantime? Call <a href={`tel:${site.phoneE164}`}>{site.phone}</a> or email{' '}
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </li>
    </ol>
    <p class="thanks__ref" data-ref-box hidden>
      Your reference: <strong data-ref></strong>
      <span class="muted">Put it in the subject if you email a drawing or photo.</span>
    </p>
  </Fragment>

  <Fragment slot="more">
    {site.store.enabled ? (
      <>
        <a class="btn" href="/shop/">Browse the catalog</a>
        <a class="btn btn--outline" href="/shop/part-numbers/">Search by part number</a>
        <a class="btn btn--outline" href="/">Back to home</a>
      </>
    ) : (
      <>
        <a class="btn" href="/">Back to home</a>
        <a class="btn btn--outline" href="/services/">Our services</a>
      </>
    )}
  </Fragment>
</ThanksPage>

<script>
  // The reference of the quote just sent (saved by the quote form in this tab). Without it, neither the box
  // nor the line that mentions it is shown.
  let ref = '';
  try {
    ref = sessionStorage.getItem('last-quote-ref') ?? '';
  } catch {
    // no reference to show
  }
  if (ref) {
    document.querySelector<HTMLElement>('[data-ref]')!.textContent = ref;
    document.querySelector<HTMLElement>('[data-ref-box]')!.hidden = false;
    document.querySelector<HTMLElement>('[data-ref-hint]')!.hidden = false;
  }
</script>
