---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FeaturedParts from '../../components/FeaturedParts.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../config/site';
import { getServices, serviceUrl } from '../../lib/content';
import { getParts, getSections, MAIN_MACHINE, sectionUrl, machineUrl } from '../../lib/parts';
import { breadcrumbs, faqPage } from '../../lib/schema';

// Parts shop switch (site.store.enabled): off hides the VFFS parts section and its FAQ entry.
const shopOn = site.store.enabled;
const services = await getServices();
const partCount = shopOn ? (await getParts()).length : 0;
const sections = shopOn ? await getSections(MAIN_MACHINE) : [];
const path = '/industries/food-processing-agriculture/';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Food Processing & Agriculture', path },
];

const faqs = [
  {
    q: 'Do you make replacement parts for food processing equipment?',
    a: `Yes. ${site.legalName} specializes in precision-engineered solutions for the food processing and agriculture industries, machining replacement and custom parts from your drawing, a worn sample or a description.`,
  },
  ...(shopOn
    ? [
        {
          q: 'Do you carry parts for VFFS packaging machines?',
          a: `Yes. Our parts catalog lists ${partCount} replacement parts for vertical form fill seal (VFFS) packaging machines, matched by OEM part number and searchable by OEM part number or C&M number. If yours is not listed, send us the number and we will quote it.`,
        },
      ]
    : []),
  {
    q: 'Where are you located?',
    a: `Our shop is at ${site.address.street}, ${site.address.city}, CA ${site.address.postalCode}, serving customers across Monterey County. Local pickup is available, or we can ship.`,
  },
];
---

<Base
  title={`Food Processing & Ag Machine Shop, ${site.address.city} CA`}
  description={shopOn
    ? `Replacement parts, machining, cutting, welding and fabrication for food processing, packaging and agriculture equipment. ${site.legalName}, ${site.address.city}, CA.`
    : `Replacement parts made to your drawing or sample, plus machining, cutting, welding and fabrication for food processing and ag equipment in ${site.address.city}, CA.`}
  jsonLd={[breadcrumbs(crumbs), faqPage(faqs)]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Industries</p>
      <h1>{shopOn ? 'Parts' : 'Replacement parts'} and fabrication for <span class="mark">food processing</span> &amp; agriculture</h1>
      <p class="lead">
        With more than 30 years of industry experience, {site.legalName} specializes in providing precision-engineered
        solutions for the food processing and agriculture industries in the Salinas Valley and across Monterey County.
      </p>
      <div class="cta-row">
        <a class="btn btn--red" href="/quote/">Request a Quote</a>
        <a class="btn btn--outline" href={`tel:${site.phoneE164}`}>Call {site.phone}</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>What we do for processors and growers</h2>
      <div class="grid">
        {services.map((s) => (
          <a class="card" href={serviceUrl(s)}>
            <div class="card__body">
              <h3>{s.data.title}</h3>
              <p class="muted">{s.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
      <ul class="ticks points">
        <li>Replacement parts machined to spec from your drawing or a worn sample</li>
        <li>Custom fabrication with or without blueprints</li>
        <li>{shopOn ? <>Local pickup in {site.address.city}, or ask about shipping</> : <>Pickup in {site.address.city}, or ask about shipping</>}</li>
        <li>{site.replyTime} to quotes and custom part requests</li>
      </ul>
    </div>
  </section>

  {shopOn && (
    <section class="section">
      <div class="container">
        <h2>Replacement parts for VFFS packaging machines</h2>
        <p>
          Our <a href={machineUrl(MAIN_MACHINE)}>parts catalog</a> lists {partCount} replacement parts for vertical form fill
          seal (VFFS) packaging machines, searchable by OEM part number or C&amp;M number:
          {sections.map((sec, i) => (
            <>
              <a href={sectionUrl(sec)}>{sec.data.title}</a>{i < sections.length - 1 ? ', ' : '.'}
            </>
          ))}
        </p>
        <FeaturedParts />
      </div>
    </section>
  )}

  <section class:list={['section', { 'section--alt': shopOn }]}>
    <div class="container faq-wrap">
      <h2>Common questions</h2>
      {faqs.map((f, i) => (
        <details class:list={['faq', { 'faq--card': !shopOn }]} open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <CtaBand heading="Down a part?" text={`Tell us what broke. ${site.replyTime}.`} />
</Base>

<style>
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .points {
    margin-top: 28px;
  }

  .faq-wrap {
    max-width: 820px;
  }

  .faq {
    margin-bottom: 12px;
    border-radius: var(--radius);
    background: var(--color-bg);
  }

  /* Parts shop off: the FAQ sits on the page background, so its cards turn white. */
  .faq--card {
    background: var(--color-surface);
  }

  .faq summary {
    min-height: 56px;
    padding: 14px 20px;
    font-weight: 600;
    cursor: pointer;
  }

  .faq p {
    margin: 0;
    padding: 0 20px 18px;
    color: var(--color-muted);
  }
</style>
