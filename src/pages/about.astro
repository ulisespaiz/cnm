---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../config/site';
import { getEquipment, getServices } from '../lib/content';
import { breadcrumbs } from '../lib/schema';
import office from '../assets/site/front-office.jpeg';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];

// Facts only, each from the site's own data: the year, the equipment list and the services collection.
const machines = await getEquipment();
const services = await getServices();
const highlights = [
  { label: 'Since', value: String(site.founded), text: `A family-owned machine shop in ${site.address.city}, ${site.address.region}.` },
  { label: 'Key machines', value: String(machines.length), text: 'Listed on our machinery page.' },
  { label: 'Services', value: String(services.length), text: services.map((s) => s.data.title.replace(/ Services$/, '')).join(', ') + '.' },
];

const values = [
  { title: 'Precision', text: 'Making each part to your drawing, sample or part number, on the machines listed on our machinery page.' },
  { title: 'Integrity', text: 'Prioritizing honesty, transparency, and trust in all interactions — with clients, employees, and the community we serve.' },
  { title: 'Family-Oriented', text: 'Nurturing a positive, growth-driven work environment that fosters innovation, respect, and long-term partnerships.' },
];
---

<Base
  title={`About ${site.name} | Family-Owned in ${site.address.city}, CA`}
  description={`${site.legalName} is a family-owned machine shop in ${site.address.city}, CA, since ${site.founded}, serving food processing, agriculture and industry around Monterey Bay.`}
  jsonLd={[breadcrumbs(crumbs)]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">About Us</p>
      <h1>Precision built on <span class="mark">craftsmanship</span> since {site.founded}</h1>
      <div class="intro">
        <div>
          <p class="lead">
            {site.legalName} has been a family-owned business in {site.address.city} since {site.founded}, built on a simple vision:
            to provide quality craftsmanship with integrity and hard work.
          </p>
          <p>
            We cut, machine, weld, roll, form and fabricate metal parts from your drawing and, when you have none, from a
            sample or an idea. {site.replyTime} to quote requests.
          </p>
        </div>
        <Image src={office} alt={`${site.name} front office in ${site.address.city}`} widths={[480, 800]} sizes="(min-width: 900px) 480px, 100vw" loading="eager" />
      </div>

      <div class="highlights">
        {highlights.map((h) => (
          <div class="highlight">
            <span class="muted">{h.label}</span>
            <strong>{h.value}</strong>
            <p class="muted">{h.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container two-col">
      <div>
        <p class="eyebrow">Our Mission</p>
        <h2>Why we do what we do</h2>
        <p>
          We make parts for food processing, agriculture and other industry. Our work is water-jet and laser cutting and
          shearing, milling and turning, rolling, forming and welding, and custom fabrication with or without blueprints.
        </p>
        <p>
          Machines in our shop include {machines.map((m) => m.data.name).join(', ').replace(/, ([^,]*)$/, ', and $1')}. <a href="/our-machinery/">See our machinery</a>.
        </p>
        <p><a href="/industries/food-processing-agriculture/">How we serve food processing &amp; <span class="nowrap">agriculture →</span></a></p>
      </div>
      <div>
        <p class="eyebrow">Our Vision</p>
        <h2>Where we're headed</h2>
        <p>
          Our vision is to be a leader in precision machining and metalworking, delivering excellence through innovation
          and craftsmanship. As a family-oriented company, we prioritize building strong relationships with our clients,
          employees, and community. We believe in continuously investing in our shop, upgrading our equipment and
          processes to enhance efficiency and simplify our work. Our commitment is to foster a culture of integrity,
          reliability, and growth.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Our Values</p>
      <h2>What we stand for</h2>
      <ol class="values">
        {values.map((v, i) => (
          <li>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{v.title}</h3>
            <p class="muted">{v.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    gap: 28px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .intro {
      grid-template-columns: 1.3fr 1fr;
    }
  }

  .intro img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .highlights,
  .values {
    display: grid;
    gap: 16px;
    margin: 36px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .highlights,
    .values {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .highlight,
  .values li {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .highlight strong {
    display: block;
    margin: 4px 0 8px;
    font-size: 1.8rem;
    letter-spacing: -0.03em;
    color: var(--color-primary);
  }

  .highlight p,
  .values p {
    margin: 0;
  }

  .values li {
    background: var(--color-bg);
  }

  .section:not(.section--alt) .values li {
    background: var(--color-surface);
  }

  .two-col {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
  }

  .num {
    display: inline-block;
    margin-bottom: 8px;
    font-weight: 700;
    color: var(--color-accent);
  }
</style>
