---
// Part page: identifier block (Hayssen part # + Copy), quantity + Add to Quote,
// specification table, related parts and previous/next. On phones the global
// call/quote bar is replaced by a sticky Add bar.
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import PartSearch from '../../../../components/PartSearch.astro';
import PartAdd from '../../../../components/PartAdd.astro';
import PartRow from '../../../../components/PartRow.astro';
import Lightbox from '../../../../components/Lightbox.astro';
import StickyAddBar from '../../../../components/StickyAddBar.astro';
import TrustStrip from '../../../../components/TrustStrip.astro';
import PartRequestForm from '../../../../components/PartRequestForm.astro';
import StoreDisclaimer from '../../../../components/StoreDisclaimer.astro';
import { addData, leadTime, photoOf } from '../../../../components/store';
import { getParts, machineUrl, neighbours, partUrl, relatedParts, sectionUrl, TYPE_LABELS } from '../../../../lib/parts';
import { breadcrumbs, product } from '../../../../lib/schema';
import { site } from '../../../../config/site';
import '../../../../styles/store.css';

export const getStaticPaths = (async () =>
  (await getParts()).map((part) => ({
    params: { machine: part.data.machine.id, section: part.data.section.id, slug: part.id },
    props: { part },
  }))) satisfies GetStaticPaths;

const { part } = Astro.props;
const d = part.data;
const all = await getParts();
const section = (await getEntry(d.section))!;
const machine = (await getEntry(d.machine))!;
const sectionTitle = section.data.title;
const url = partUrl(part);

const photos = await Promise.all(d.images.map(photoOf));
const add = await addData(part, sectionTitle);
const related = relatedParts(part, all, 4);
const { prev, next } = neighbours(part, all);

const availability = { ask: leadTime(), 'in-stock': 'In stock', 'made-to-order': 'Made to order' }[d.availability];
const specs: { label: string; value: string; mono?: boolean }[] = [
  { label: 'Hayssen part #', value: d.oem, mono: true },
  { label: 'C&M #', value: d.cm, mono: true },
  { label: 'Machine', value: machine.data.name },
  { label: 'Section', value: sectionTitle },
  { label: 'Type', value: TYPE_LABELS[d.type] },
  ...(d.attrs.width ? [{ label: 'Width', value: `${d.attrs.width}″` }] : []),
  ...(d.attrs.side ? [{ label: 'Side', value: d.attrs.side === 'LH' ? 'Left (LH)' : 'Right (RH)' }] : []),
  ...(d.attrs.size ? [{ label: 'Size', value: d.attrs.size }] : []),
  ...(d.note ? [{ label: 'Note', value: d.note }] : []),
  { label: 'Lead time', value: availability },
];

const title = `${d.name} ${d.oem} | Hayssen VFFS Replacement Part`;
const description = `${d.name}, Hayssen part # ${d.oem}, C&M # ${d.cm}. Replacement part for Hayssen VFFS machines, from C&M Machine Shop in Salinas, CA. Request a quote.`;
const jsonLd = [
  product({
    name: d.name,
    description: `${d.name}. Replacement part for Hayssen VFFS machines, Hayssen part number ${d.oem}, C&M number ${d.cm}.`,
    path: url,
    images: photos.map((p) => p.src),
    category: sectionTitle,
    sku: d.cm,
    oem: d.oem,
  }),
  breadcrumbs([
    { name: 'Parts Store', path: '/shop/' },
    { name: machine.data.name, path: machineUrl(machine.id) },
    { name: sectionTitle, path: sectionUrl(section) },
    { name: d.name, path: url },
  ]),
];
---

<Base title={title} description={description} jsonLd={jsonLd} hideMobileBar>
  <div class="storebar">
    <div class="container container--wide"><PartSearch variant="bar" /></div>
  </div>

  <div class="container container--wide part-page">
    <div class="crumbs-desktop">
      <Breadcrumbs
        items={[
          { name: 'Parts Store', path: '/shop/' },
          { name: machine.data.name, path: machineUrl(machine.id) },
          { name: sectionTitle, path: sectionUrl(section) },
          { name: d.name, path: url },
        ]}
      />
    </div>
    <a class="back-link" href={sectionUrl(section)}>‹ {sectionTitle}</a>

    <article class="part">
      <header class="part__head">
        <p class="part__eyebrow">
          <a href={machineUrl(machine.id)}>{machine.data.name}</a> · <a href={sectionUrl(section)}>{sectionTitle}</a>
        </p>
        <h1>{d.name}</h1>
        <div class="ident">
          <p class="ident__label">Hayssen part #</p>
          <div class="ident__row">
            <span class="ident__oem" id="part-oem">{d.oem}</span>
            <button type="button" class="copybtn copybtn--text" data-copy={d.oem} aria-describedby="part-oem">
              <svg class="i-copy" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
              <svg class="i-check" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <p class="ident__cm">
            C&amp;M # <strong>{d.cm}</strong>
            <button type="button" class="copybtn copybtn--sm" data-copy={d.cm} aria-label={`Copy C&M number ${d.cm}`}>
              <span data-copy-label>Copy</span>
            </button>
          </p>
        </div>
      </header>

      <div class="part__photo">
        <Lightbox photos={photos} alt={d.imageAlt} />
        {d.sharedPhoto && <p class="store-hint">Photo shows a similar part.</p>}
      </div>

      <div class="part__rest">
        <p class="part__fit">
          Replacement part for Hayssen VFFS machines. Confirm fitment by part number, or call us and describe your machine.
        </p>

        <div class="part__add">
          <PartAdd data={add} variant="page" />
        </div>

        <TrustStrip variant="list" limit={3} />
        <a class="part__call btn btn--outline" href={`tel:${site.phoneE164}`}>Call {site.phone}</a>

        <h2 class="part__h2">Specifications</h2>
        <dl class="specs">
          {
            specs.map((s) => (
              <div class="specs__row">
                <dt>{s.label}</dt>
                <dd class:list={{ mono: s.mono }}>{s.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          d.aka.length > 0 && (
            <p class="part__aka">
              <strong>Also known as:</strong> {d.aka.join(', ')}
            </p>
          )
        }
      </div>
    </article>

    {
      related.length > 0 && (
        <section class="rel" aria-labelledby="rel-title">
          <h2 id="rel-title" class="part__h2">More in {sectionTitle}</h2>
          <div class="plist">
            <div class="plist__head" aria-hidden="true">
              <span />
              <span>Part</span>
              <span>Hayssen part #</span>
              <span>C&amp;M #</span>
              <span>Quantity</span>
            </div>
            <ol class="plist__rows">
              {related.map((p) => <PartRow part={p} sectionTitle={sectionTitle} />)}
            </ol>
          </div>
        </section>
      )
    }

    <nav class="pn" aria-label="Previous and next part">
      {
        prev ? (
          <a class="pn__link" href={partUrl(prev)} rel="prev">
            <span class="pn__dir">‹ Previous</span>
            <span class="pn__name">{prev.data.name}</span>
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next && (
          <a class="pn__link pn__link--next" href={partUrl(next)} rel="next">
            <span class="pn__dir">Next ›</span>
            <span class="pn__name">{next.data.name}</span>
          </a>
        )
      }
    </nav>

    <details class="req" id="request-details">
      <summary>Can't find your part? Request it by number</summary>
      <PartRequestForm compact />
    </details>

    <StoreDisclaimer />
  </div>

  <StickyAddBar data={add} />
</Base>

<style is:global>
  @media (max-width: 767px) {
    body {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
  }
</style>

<style>
  .part-page {
    padding-block: 8px 40px;
  }

  .part {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'head'
      'photo'
      'rest';
    margin-bottom: 28px;
  }

  .part__head {
    grid-area: head;
  }

  .part__photo {
    grid-area: photo;
  }

  .part__rest {
    grid-area: rest;
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .part__eyebrow {
    margin: 0 0 4px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .part__eyebrow a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  .part h1 {
    margin-bottom: 14px;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .ident {
    padding: 14px 16px;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius);
    background: #fff;
  }

  .ident__label {
    margin: 0;
    color: #444;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .ident__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
  }

  .ident__oem {
    font-family: var(--oem-font);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 1.9rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    color: #111;
  }

  .ident__cm {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 4px 0 -6px;
    color: #333;
  }

  .copybtn--sm {
    width: auto;
    min-width: 64px;
    padding: 0 10px;
    font-size: 0.9rem;
  }

  .part__fit {
    margin: 0;
    color: #333;
  }

  .part__add {
    display: none;
  }

  .part__call {
    justify-self: start;
  }

  .part__h2 {
    margin: 10px 0 0;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
  }

  .specs {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .specs__row {
    display: grid;
    grid-template-columns: minmax(110px, 38%) minmax(0, 1fr);
    gap: 12px;
    padding: 10px 14px;
    border-top: 1px solid var(--color-border);
  }

  .specs__row:first-child {
    border-top: 0;
  }

  .specs dt {
    color: #444;
    font-weight: 600;
  }

  .specs dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .specs .mono {
    font-family: var(--oem-font);
    font-weight: 700;
  }

  .part__aka {
    margin: 0;
  }

  .rel {
    margin-top: 8px;
  }

  .rel :global(.plist__head) {
    position: static;
  }

  .rel :global(.prow) {
    content-visibility: visible;
  }

  .pn {
    display: grid;
    gap: 10px;
    margin-block: 20px;
  }

  .pn__link {
    display: grid;
    gap: 2px;
    min-height: 64px;
    padding: 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    color: inherit;
    text-decoration: none;
  }

  .pn__link:hover {
    border-color: var(--color-primary);
  }

  .pn__dir {
    color: var(--color-primary);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .pn__name {
    font-weight: 600;
  }

  .req {
    margin-bottom: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .req > summary {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 0 16px;
    font-weight: 700;
    cursor: pointer;
  }

  .req[open] > summary {
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .part__add {
      display: block;
    }

    .part__add :global(.padd__add) {
      min-height: 56px;
      height: 56px;
      min-width: 190px;
    }

    .pn {
      grid-template-columns: 1fr 1fr;
    }

    .pn__link--next {
      text-align: right;
    }
  }

  @media (min-width: 900px) {
    .part {
      gap: 0 48px;
      grid-template-columns: 320px minmax(0, 1fr);
      grid-template-areas:
        'photo head'
        'photo rest';
      grid-template-rows: auto 1fr;
      align-items: start;
    }

    .part__photo {
      position: sticky;
      top: calc(var(--store-header) + var(--store-bar) + 16px);
      padding-top: 6px;
    }

    .part__rest {
      margin-top: 16px;
    }
  }
</style>
