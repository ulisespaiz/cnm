---
// Part page: identifier block (OEM # + Copy, or the C&M # for a part with
// no OEM number), description, quantity + Add to Quote, specification table,
// related parts and previous/next. On phones the global
// call/quote bar is replaced by a sticky Add bar.
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import PartSearch from '../../../../components/PartSearch.astro';
import PartAdd from '../../../../components/PartAdd.astro';
import PartRow from '../../../../components/PartRow.astro';
import Lightbox from '../../../../components/Lightbox.astro';
import StickyAddBar from '../../../../components/StickyAddBar.astro';
import TrustStrip from '../../../../components/TrustStrip.astro';
import PartRequestForm from '../../../../components/PartRequestForm.astro';
import StoreDisclaimer from '../../../../components/StoreDisclaimer.astro';
import { addData, leadTime, photoOf } from '../../../../components/store';
import { getParts, machineUrl, mainNumber, neighbours, partUrl, relatedParts, sectionUrl, sharedOemParts, TYPE_LABELS } from '../../../../lib/parts';
import { displayName, partJsonLdDescription, partMetaDescription, partTitles } from '../../../../lib/partmeta';
import { breadcrumbs, product } from '../../../../lib/schema';
import { site } from '../../../../config/site';
import '../../../../styles/store.css';

// Parts shop off (site.store.enabled): no pages. The part photos are still emitted by the
// parts collection; the shop-switch integration in astro.config.mjs deletes them from dist.
export const getStaticPaths = (async () =>
  site.store.enabled
    ? (await getParts()).map((part) => ({
        params: { machine: part.data.machine.id, section: part.data.section.id, slug: part.id },
        props: { part },
      }))
    : []) satisfies GetStaticPaths;

const { part } = Astro.props;
const d = part.data;
const all = await getParts();
const section = (await getEntry(d.section))!;
const machine = (await getEntry(d.machine))!;
const sectionTitle = section.data.title;
const url = partUrl(part);

const photos = await Promise.all(d.images.map(photoOf));
const add = await addData(part, sectionTitle);
const related = relatedParts(part, all, 4);
const { prev, next } = neighbours(part, all);

// With no lead time on file the shop's standing line ("Lead time confirmed on your quote") would repeat the row's label.
const askLeadTime = leadTime() === site.store.leadTimeFallback ? 'Confirmed on your quote' : leadTime();
const availability = { ask: askLeadTime, 'in-stock': 'In stock', 'made-to-order': 'Made to order' }[d.availability];
// A part with no OEM number is identified by its C&M number alone.
const mainNo = mainNumber(d);
const specs: { label: string; value: string; mono?: boolean }[] = [
  ...(d.oem ? [{ label: 'OEM #', value: d.oem, mono: true }] : []),
  { label: 'C&M #', value: d.cm, mono: true },
  { label: 'Machine', value: machine.data.name },
  { label: 'Section', value: sectionTitle },
  { label: 'Type', value: TYPE_LABELS[d.type] },
  ...(d.attrs.width ? [{ label: 'Width', value: `${d.attrs.width}″` }] : []),
  ...(d.attrs.side ? [{ label: 'Side', value: d.attrs.side === 'LH' ? 'Left (LH)' : 'Right (RH)' }] : []),
  ...(d.attrs.size ? [{ label: 'Size', value: d.attrs.size }] : []),
  ...(d.note ? [{ label: 'Note', value: d.note }] : []),
  { label: 'Lead time', value: availability },
];

// The <title> and the meta description come from src/lib/partmeta.ts (the same template for every part, checked
// at build time): the part name is never cut, and a part whose OEM number is still being confirmed says so.
const title = partTitles(all).get(part.id)!;
// Link previews have room for the whole name and the brand.
const ogTitle = `${d.name} ${mainNo} | VFFS Replacement Part | ${site.name}`;
const description = partMetaDescription(d);
// Other parts with the same OEM number (two pairs share one): the page says so and links the other part.
const sharedWith = sharedOemParts(part, all);
const countWord = (n: number) => ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six'][n] ?? String(n);
const lead = d.description?.trim() || '';
// The opening "Replacement part for VFFS packaging machines..." sentence of the fit line is dropped when the
// description already says so. The closing line names the way to confirm the part: its OEM number, or, for a part
// with no OEM number, a sample, print or photo (the buyer has no number to give).
const leadSaysFit = /\bVFFS\b/.test(lead);
const confirmLine = d.oem
  ? 'Confirm fitment by part number, or call us and describe your machine.'
  : 'Send a sample, print or photo of the part with your quote, or call us and describe your machine.';
// Link preview: the first photo as a JPEG at its native size (never scaled up), which is what
// Facebook and X read. A part with no photo falls back to the shop's og.jpg.
const shot = d.images[0];
const share = shot ? await getImage({ src: shot, width: Math.min(shot.width, 250), format: 'jpg', quality: 82 }) : undefined;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Parts Store', path: '/shop/' },
  { name: machine.data.name, path: machineUrl(machine.id) },
  { name: sectionTitle, path: sectionUrl(section) },
  { name: d.name, path: url },
];
const jsonLd = [
  product({
    name: d.name,
    description: partJsonLdDescription(d),
    path: url,
    images: photos.map((p) => p.src),
    category: sectionTitle,
    sku: d.cm,
    oem: d.oem,
  }),
  breadcrumbs(crumbs),
];
---

<Base
  title={title}
  brand={false}
  ogTitle={ogTitle}
  description={description}
  image={share?.src}
  imageAlt={share ? d.imageAlt : undefined}
  imageWidth={share?.options.width}
  imageHeight={share?.options.height}
  twitterCard={share ? 'summary' : undefined}
  jsonLd={jsonLd}
  hideMobileBar
>
  <div class="storebar storebar--static">
    <div class="container container--wide"><PartSearch variant="bar" /></div>
  </div>

  <div class="container container--wide part-page">
    <div class="crumbs-desktop">
      <Breadcrumbs items={crumbs} />
    </div>
    <a class="back-link" href={sectionUrl(section)}>‹ {sectionTitle}</a>

    <article class="part">
      <header class="part__head">
        <p class="part__eyebrow">
          <a href={machineUrl(machine.id)}>{machine.data.name}</a> · <a href={sectionUrl(section)}>{sectionTitle}</a>
        </p>
        <h1>{d.name} <span class="part__h1no">{mainNo}</span></h1>
        <div class="ident">
          <p class="ident__label">{d.oem ? 'OEM #' : 'C&M part #'}</p>
          <div class="ident__row">
            <span class="ident__oem" id="part-oem">{mainNo}</span>
            <button type="button" class="copybtn copybtn--text" data-copy={mainNo} aria-describedby="part-oem">
              <svg class="i-copy" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
              <svg class="i-check" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          {
            d.oem ? (
              <p class="ident__cm">
                C&amp;M # <strong>{d.cm}</strong>
                <button type="button" class="copybtn copybtn--sm" data-copy={d.cm} aria-label={`Copy C&M number ${d.cm}`}>
                  <span data-copy-label>Copy</span>
                </button>
              </p>
            ) : (
              <p class="ident__none">This part has no OEM number. Give us the C&amp;M number when you ask for a quote.</p>
            )
          }
        </div>
        {
          sharedWith.length > 0 && (
            <p class="part__shared" role="note" data-shared-oem>
              {countWord(sharedWith.length + 1)} parts in our catalog use <span class="nowrap">OEM # {d.oem}</span>:{' '}
              {sharedWith.map((other, i) => (
                <>
                  <a href={partUrl(other)}>{other.data.name}</a>
                  {i < sharedWith.length - 1 ? ', ' : ''}
                </>
              ))}{' '}
              and this one. Check the name and photo, or send a photo of your part with your quote.
            </p>
          )
        }
      </header>

      <div class="part__photo">
        <Lightbox photos={photos} alt={d.imageAlt} />
        {d.sharedPhoto && <p class="store-hint">Photo shows a similar part.</p>}
      </div>

      <div class="part__rest">
        {lead && <p class="part__lead">{lead}</p>}
        <p class="part__fit">
          {!leadSaysFit && <>Replacement part for VFFS packaging machines{d.oem ? ', matched by OEM part number' : ''}. </>}{confirmLine}
        </p>

        <div class="part__add">
          <PartAdd data={add} variant="page" />
        </div>
        <StickyAddBar data={add} />

        <TrustStrip variant="list" limit={3} />
        <a class="part__call btn btn--outline" href={`tel:${site.phoneE164}`}>Call {site.phone}</a>

        <h2 class="part__h2">Specifications</h2>
        <dl class="specs">
          {
            specs.map((s) => (
              <div class="specs__row">
                <dt>{s.label}</dt>
                <dd class:list={{ mono: s.mono }}>{s.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          d.aka.length > 0 && (
            <p class="part__aka">
              <strong>Also known as:</strong> {d.aka.join(', ')}
            </p>
          )
        }
      </div>
    </article>

    {
      related.length > 0 && (
        <section class="rel" aria-labelledby="rel-title">
          <h2 id="rel-title" class="part__h2">More in {sectionTitle}</h2>
          <div class="plist">
            <div class="plist__head" aria-hidden="true">
              <span />
              <span>Part</span>
              <span>OEM #</span>
              <span>C&amp;M #</span>
              <span>Quantity</span>
            </div>
            <ol class="plist__rows">
              {related.map((p) => <PartRow part={p} sectionTitle={sectionTitle} />)}
            </ol>
          </div>
        </section>
      )
    }

    <nav class="pn" aria-label="Previous and next part">
      {
        prev ? (
          <a class="pn__link" href={partUrl(prev)} rel="prev">
            <span class="pn__dir">‹ Previous</span>
            <span class="pn__name">{displayName(prev.data)}</span>
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next && (
          <a class="pn__link pn__link--next" href={partUrl(next)} rel="next">
            <span class="pn__dir">Next ›</span>
            <span class="pn__name">{displayName(next.data)}</span>
          </a>
        )
      }
    </nav>

    <details class="req" id="request-details">
      <summary>
        Can't find your part? Request it by number
        <svg class="req__chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4.5l4 4 4-4" /></svg>
      </summary>
      <PartRequestForm compact />
    </details>

    <StoreDisclaimer />
  </div>
</Base>

<style is:global>
  @media (max-width: 767px) {
    body {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
  }
</style>

<style>
  .part-page {
    padding-block: 8px 40px;
  }

  .part {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'head'
      'photo'
      'rest';
    margin-bottom: 28px;
  }

  .part__head {
    grid-area: head;
  }

  .part__photo {
    grid-area: photo;
  }

  .part__rest {
    grid-area: rest;
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .part__eyebrow {
    margin: 0 0 4px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .part__eyebrow a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* phones: the back link above the title already names the section */
  @media (max-width: 767px) {
    .part__eyebrow {
      display: none;
    }
  }

  .part h1 {
    margin-bottom: 14px;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  /* The number follows the name, small and muted; it moves to the next line whole, never mid-number. */
  .part__h1no {
    display: inline-block;
    color: var(--color-muted);
    font-family: var(--oem-font);
    font-size: 0.55em;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .ident {
    padding: 14px 16px;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius);
    background: #fff;
  }

  .ident__label {
    margin: 0;
    color: #444;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .ident__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
  }

  .ident__oem {
    font-family: var(--oem-font);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 1.9rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    color: #111;
  }

  .ident__cm {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 4px 0 -6px;
    color: #333;
  }

  .ident__none {
    margin: 4px 0 0;
    color: #333;
    font-size: 0.95rem;
  }

  .copybtn--sm {
    width: auto;
    min-width: 64px;
    padding: 0 10px;
    font-size: 0.9rem;
  }

  /* Two parts share this OEM number: a short note under the number, with a link to the other part. */
  .part__shared {
    margin: 12px 0 0;
    padding: 10px 14px;
    border-left: 4px solid var(--color-primary);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--color-tint);
    color: #222;
    font-size: 0.975rem;
    line-height: 1.5;
  }

  .part__shared a {
    font-weight: 700;
    text-decoration: underline;
  }

  .part__lead {
    margin: 0;
    color: #222;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .part__fit {
    margin: 0;
    color: #333;
  }

  .part__add {
    display: none;
  }

  .part__call {
    justify-self: start;
  }

  .part__h2 {
    margin: 10px 0 0;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
  }

  .specs {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .specs__row {
    display: grid;
    grid-template-columns: minmax(110px, 38%) minmax(0, 1fr);
    gap: 12px;
    padding: 10px 14px;
    border-top: 1px solid var(--color-border);
  }

  .specs__row:first-child {
    border-top: 0;
  }

  .specs dt {
    color: #444;
    font-weight: 600;
  }

  .specs dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .specs .mono {
    font-family: var(--oem-font);
    font-weight: 700;
  }

  .part__aka {
    margin: 0;
  }

  .rel {
    margin-top: 8px;
  }

  .rel .part__h2 {
    margin-bottom: 12px;
  }

  .rel :global(.plist__head) {
    position: static;
  }

  .rel :global(.prow) {
    content-visibility: visible;
  }

  .pn {
    display: grid;
    gap: 10px;
    margin-block: 20px;
  }

  .pn__link {
    display: grid;
    gap: 2px;
    min-height: 64px;
    padding: 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    color: inherit;
    text-decoration: none;
  }

  .pn__link:hover {
    border-color: var(--color-primary);
  }

  .pn__dir {
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .pn__name {
    font-weight: 600;
  }

  .req {
    margin-bottom: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .req > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 14px 16px;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }

  .req > summary::-webkit-details-marker {
    display: none;
  }

  .req__chev {
    flex: none;
    transition: transform 0.15s;
  }

  .req[open] .req__chev {
    transform: rotate(180deg);
  }

  .req[open] > summary {
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .part__add {
      display: block;
    }

    .part__add :global(.padd__add) {
      min-height: 56px;
      height: 56px;
      min-width: 190px;
    }

    .pn {
      grid-template-columns: 1fr 1fr;
    }

    .pn__link--next {
      text-align: right;
    }

    /* photo column about 240-300px beside the title, number and specs */
    .part {
      gap: 0 32px;
      grid-template-columns: clamp(240px, 30vw, 300px) minmax(0, 1fr);
      grid-template-areas:
        'photo head'
        'photo rest';
      grid-template-rows: auto 1fr;
      align-items: start;
    }

    .part__photo {
      position: sticky;
      top: calc(var(--store-stick) + 16px);
      padding-top: 6px;
    }

    .part__rest {
      margin-top: 16px;
    }
  }

  @media (min-width: 1024px) {
    .part {
      gap: 0 48px;
    }
  }
</style>
