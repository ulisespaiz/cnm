---
// Part page: identifier block (OEM # + Copy, or the C&M # for a part with
// no OEM number), description, quantity + Add to Quote, specification table,
// related parts and previous/next. On phones the global
// call/quote bar is replaced by a sticky Add bar.
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import PartSearch from '../../../../components/PartSearch.astro';
import PartAdd from '../../../../components/PartAdd.astro';
import PartRow from '../../../../components/PartRow.astro';
import Lightbox from '../../../../components/Lightbox.astro';
import StickyAddBar from '../../../../components/StickyAddBar.astro';
import TrustStrip from '../../../../components/TrustStrip.astro';
import PartRequestForm from '../../../../components/PartRequestForm.astro';
import StoreDisclaimer from '../../../../components/StoreDisclaimer.astro';
import { addData, leadTime, photoOf } from '../../../../components/store';
import { getParts, machineUrl, mainNumber, neighbours, partUrl, relatedParts, sectionUrl, TYPE_LABELS } from '../../../../lib/parts';
import { breadcrumbs, product } from '../../../../lib/schema';
import { site } from '../../../../config/site';
import '../../../../styles/store.css';

// Parts shop off (site.store.enabled): no pages. The part photos are still emitted by the
// parts collection; the shop-switch integration in astro.config.mjs deletes them from dist.
export const getStaticPaths = (async () =>
  site.store.enabled
    ? (await getParts()).map((part) => ({
        params: { machine: part.data.machine.id, section: part.data.section.id, slug: part.id },
        props: { part },
      }))
    : []) satisfies GetStaticPaths;

const { part } = Astro.props;
const d = part.data;
const all = await getParts();
const section = (await getEntry(d.section))!;
const machine = (await getEntry(d.machine))!;
const sectionTitle = section.data.title;
const url = partUrl(part);

const photos = await Promise.all(d.images.map(photoOf));
const add = await addData(part, sectionTitle);
const related = relatedParts(part, all, 4);
const { prev, next } = neighbours(part, all);

// With no lead time on file the shop's standing line ("Lead time confirmed on your quote") would repeat the row's label.
const askLeadTime = leadTime() === site.store.leadTimeFallback ? 'Confirmed on your quote' : leadTime();
const availability = { ask: askLeadTime, 'in-stock': 'In stock', 'made-to-order': 'Made to order' }[d.availability];
// A part with no OEM number is identified by its C&M number alone.
const mainNo = mainNumber(d);
const specs: { label: string; value: string; mono?: boolean }[] = [
  ...(d.oem ? [{ label: 'OEM #', value: d.oem, mono: true }] : []),
  { label: 'C&M #', value: d.cm, mono: true },
  { label: 'Machine', value: machine.data.name },
  { label: 'Section', value: sectionTitle },
  { label: 'Type', value: TYPE_LABELS[d.type] },
  ...(d.attrs.width ? [{ label: 'Width', value: `${d.attrs.width}″` }] : []),
  ...(d.attrs.side ? [{ label: 'Side', value: d.attrs.side === 'LH' ? 'Left (LH)' : 'Right (RH)' }] : []),
  ...(d.attrs.size ? [{ label: 'Size', value: d.attrs.size }] : []),
  ...(d.note ? [{ label: 'Note', value: d.note }] : []),
  { label: 'Lead time', value: availability },
];

// Titles stay within 65 characters once decoded (search results cut them off). The part number and
// "VFFS Part" always stay: first the whole title with the shop name, then without it, then with the
// part name clipped at a word boundary.
const TITLE_LIMIT = 65;
const partTitle = (name: string) => `${mainNo} ${name} | VFFS Part`;
function clippedTitleName() {
  const words = d.name.split(' ');
  while (words.length > 1) {
    words.pop();
    let text = words.join(' ');
    // Do not stop inside an open parenthesis, or on a trailing comma or a dangling "x" / "with".
    if ((text.match(/\(/g) ?? []).length > (text.match(/\)/g) ?? []).length) continue;
    text = text.replace(/[\s,;:/&-]+$/, '').replace(/\s+(?:x|with|for|and|of)$/i, '');
    if (partTitle(`${text}…`).length <= TITLE_LIMIT) return `${text}…`;
  }
  return `${words[0]}…`;
}
const withBrand = `${partTitle(d.name)} | ${site.name}`;
const withoutBrand = partTitle(d.name);
const title =
  withBrand.length <= TITLE_LIMIT ? withBrand : withoutBrand.length <= TITLE_LIMIT ? withoutBrand : partTitle(clippedTitleName());
// Link previews have room for the whole name and the brand.
const ogTitle = `${d.name} ${mainNo} | VFFS Replacement Part | ${site.name}`;
// Meta descriptions stay within 160 characters (search results cut them off): use the
// fullest wording that fits, then shorter ones. A part with no OEM number is named
// by its C&M number. Fit is always tied to a number, never to the machine type alone.
const idShort = d.oem ? `OEM # ${d.oem}` : `C&M part # ${d.cm}`;
const idLong = d.oem ? `${idShort}, C&M # ${d.cm}` : idShort;
const matchedBy = d.oem ? 'matched by OEM part number' : 'ordered by C&M number';
const descriptionOptions = [
  `${d.name}, ${idLong}. Replacement part for VFFS packaging machines, ${matchedBy}. From C&M Machine Shop in Salinas, CA. Request a quote.`,
  `${d.name}, ${idShort}. Replacement part for VFFS packaging machines, ${matchedBy}. From C&M Machine Shop. Request a quote.`,
  `${d.name}, ${idShort}. Replacement part for VFFS packaging machines, ${matchedBy}. Request a quote.`,
  `${d.name}, ${idShort}. Replacement part for VFFS packaging machines, ${matchedBy}.`,
  `${d.name}, ${idShort}. Replacement part for VFFS packaging machines. Request a quote.`,
];
// Measure the HTML-escaped length too, so the limit holds in the page source as well.
const escapedLength = (text: string) => text.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/'/g, '&#39;').length;
// When the part has a written description, its first sentence is the meta description if it fits
// and is worth showing alone: long enough to say something and carrying the part's main number
// (OEM number, or C&M number when it has none). A short opener or a question like
// "Looking for OEM part number X?" falls back to the standard wording below.
const firstSentence = (text: string) => /^.+?[.!?](?=\s|$)/s.exec(text.trim())?.[0] ?? text.trim();
const lead = d.description?.trim() || '';
// The opening "Replacement part for VFFS packaging machines..." sentence of the fit line is dropped when the
// description already says so; "Confirm fitment by part number..." always stays.
const leadSaysFit = /\bVFFS\b/.test(lead);
const leadSentence = lead ? firstSentence(lead) : '';
const leadWorksAlone = leadSentence.length >= 70 && !leadSentence.endsWith('?') && leadSentence.includes(mainNo);
// A very long part name: cut the name, never the part number that follows it.
function clippedName() {
  const tail = `, ${idShort}. Request a quote.`;
  let name = d.name;
  while (name.length > 20 && escapedLength(`${name}…${tail}`) > 160) name = name.slice(0, -1);
  return name === d.name ? `${name}${tail}` : `${name.trimEnd()}…${tail}`;
}
const baseDescription =
  leadWorksAlone && escapedLength(leadSentence) <= 160
    ? leadSentence
    : (descriptionOptions.find((text) => escapedLength(text) <= 160) ?? clippedName());
// Say where the shop is when the wording has not already and there is room for it.
const localTail = ` Quote from ${site.name} in ${site.address.city}, CA.`;
const description =
  !baseDescription.includes(site.address.city) && escapedLength(`${baseDescription}${localTail}`) <= 160
    ? `${baseDescription}${localTail}`
    : baseDescription;
// Link preview: the first photo as a JPEG at its native size (never scaled up), which is what
// Facebook and X read. A part with no photo falls back to the shop's og.jpg.
const shot = d.images[0];
const share = shot ? await getImage({ src: shot, width: Math.min(shot.width, 250), format: 'jpg', quality: 82 }) : undefined;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Parts Store', path: '/shop/' },
  { name: machine.data.name, path: machineUrl(machine.id) },
  { name: sectionTitle, path: sectionUrl(section) },
  { name: d.name, path: url },
];
const jsonLd = [
  product({
    name: d.name,
    description:
      lead ||
      `${d.name}. Replacement part for VFFS packaging machines, ${d.oem ? `OEM part number ${d.oem}, ` : ''}C&M number ${d.cm}.`,
    path: url,
    images: photos.map((p) => p.src),
    category: sectionTitle,
    sku: d.cm,
    oem: d.oem,
  }),
  breadcrumbs(crumbs),
];
---

<Base
  title={title}
  brand={false}
  ogTitle={ogTitle}
  description={description}
  image={share?.src}
  imageAlt={share ? d.imageAlt : undefined}
  imageWidth={share?.options.width}
  imageHeight={share?.options.height}
  twitterCard={share ? 'summary' : undefined}
  jsonLd={jsonLd}
  hideMobileBar
>
  <div class="storebar storebar--static">
    <div class="container container--wide"><PartSearch variant="bar" /></div>
  </div>

  <div class="container container--wide part-page">
    <div class="crumbs-desktop">
      <Breadcrumbs items={crumbs} />
    </div>
    <a class="back-link" href={sectionUrl(section)}>‹ {sectionTitle}</a>

    <article class="part">
      <header class="part__head">
        <p class="part__eyebrow">
          <a href={machineUrl(machine.id)}>{machine.data.name}</a> · <a href={sectionUrl(section)}>{sectionTitle}</a>
        </p>
        <h1>{d.name} <span class="part__h1no">{mainNo}</span></h1>
        <div class="ident">
          <p class="ident__label">{d.oem ? 'OEM #' : 'C&M part #'}</p>
          <div class="ident__row">
            <span class="ident__oem" id="part-oem">{mainNo}</span>
            <button type="button" class="copybtn copybtn--text" data-copy={mainNo} aria-describedby="part-oem">
              <svg class="i-copy" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
              <svg class="i-check" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          {
            d.oem ? (
              <p class="ident__cm">
                C&amp;M # <strong>{d.cm}</strong>
                <button type="button" class="copybtn copybtn--sm" data-copy={d.cm} aria-label={`Copy C&M number ${d.cm}`}>
                  <span data-copy-label>Copy</span>
                </button>
              </p>
            ) : (
              <p class="ident__none">This part has no OEM number. Give us the C&amp;M number when you ask for a quote.</p>
            )
          }
        </div>
      </header>

      <div class="part__photo">
        <Lightbox photos={photos} alt={d.imageAlt} />
        {d.sharedPhoto && <p class="store-hint">Photo shows a similar part.</p>}
      </div>

      <div class="part__rest">
        {lead && <p class="part__lead">{lead}</p>}
        <p class="part__fit">
          {!leadSaysFit && <>Replacement part for VFFS packaging machines{d.oem ? ', matched by OEM part number' : ''}. </>}Confirm fitment by part number, or call us and describe your machine.
        </p>

        <div class="part__add">
          <PartAdd data={add} variant="page" />
        </div>
        <StickyAddBar data={add} />

        <TrustStrip variant="list" limit={3} />
        <a class="part__call btn btn--outline" href={`tel:${site.phoneE164}`}>Call {site.phone}</a>

        <h2 class="part__h2">Specifications</h2>
        <dl class="specs">
          {
            specs.map((s) => (
              <div class="specs__row">
                <dt>{s.label}</dt>
                <dd class:list={{ mono: s.mono }}>{s.value}</dd>
              </div>
            ))
          }
        </dl>

        {
          d.aka.length > 0 && (
            <p class="part__aka">
              <strong>Also known as:</strong> {d.aka.join(', ')}
            </p>
          )
        }
      </div>
    </article>

    {
      related.length > 0 && (
        <section class="rel" aria-labelledby="rel-title">
          <h2 id="rel-title" class="part__h2">More in {sectionTitle}</h2>
          <div class="plist">
            <div class="plist__head" aria-hidden="true">
              <span />
              <span>Part</span>
              <span>OEM #</span>
              <span>C&amp;M #</span>
              <span>Quantity</span>
            </div>
            <ol class="plist__rows">
              {related.map((p) => <PartRow part={p} sectionTitle={sectionTitle} />)}
            </ol>
          </div>
        </section>
      )
    }

    <nav class="pn" aria-label="Previous and next part">
      {
        prev ? (
          <a class="pn__link" href={partUrl(prev)} rel="prev">
            <span class="pn__dir">‹ Previous</span>
            <span class="pn__name">{prev.data.name}</span>
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next && (
          <a class="pn__link pn__link--next" href={partUrl(next)} rel="next">
            <span class="pn__dir">Next ›</span>
            <span class="pn__name">{next.data.name}</span>
          </a>
        )
      }
    </nav>

    <details class="req" id="request-details">
      <summary>
        Can't find your part? Request it by number
        <svg class="req__chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4.5l4 4 4-4" /></svg>
      </summary>
      <PartRequestForm compact />
    </details>

    <StoreDisclaimer />
  </div>
</Base>

<style is:global>
  @media (max-width: 767px) {
    body {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
  }
</style>

<style>
  .part-page {
    padding-block: 8px 40px;
  }

  .part {
    display: grid;
    gap: 16px;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'head'
      'photo'
      'rest';
    margin-bottom: 28px;
  }

  .part__head {
    grid-area: head;
  }

  .part__photo {
    grid-area: photo;
  }

  .part__rest {
    grid-area: rest;
    display: grid;
    gap: 14px;
    align-content: start;
  }

  .part__eyebrow {
    margin: 0 0 4px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .part__eyebrow a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* phones: the back link above the title already names the section */
  @media (max-width: 767px) {
    .part__eyebrow {
      display: none;
    }
  }

  .part h1 {
    margin-bottom: 14px;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  /* The number follows the name, small and muted; it moves to the next line whole, never mid-number. */
  .part__h1no {
    display: inline-block;
    color: var(--color-muted);
    font-family: var(--oem-font);
    font-size: 0.55em;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .ident {
    padding: 14px 16px;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius);
    background: #fff;
  }

  .ident__label {
    margin: 0;
    color: #444;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .ident__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
  }

  .ident__oem {
    font-family: var(--oem-font);
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 1.9rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    color: #111;
  }

  .ident__cm {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 4px 0 -6px;
    color: #333;
  }

  .ident__none {
    margin: 4px 0 0;
    color: #333;
    font-size: 0.95rem;
  }

  .copybtn--sm {
    width: auto;
    min-width: 64px;
    padding: 0 10px;
    font-size: 0.9rem;
  }

  .part__lead {
    margin: 0;
    color: #222;
    font-size: 1.05rem;
    line-height: 1.55;
  }

  .part__fit {
    margin: 0;
    color: #333;
  }

  .part__add {
    display: none;
  }

  .part__call {
    justify-self: start;
  }

  .part__h2 {
    margin: 10px 0 0;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
  }

  .specs {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .specs__row {
    display: grid;
    grid-template-columns: minmax(110px, 38%) minmax(0, 1fr);
    gap: 12px;
    padding: 10px 14px;
    border-top: 1px solid var(--color-border);
  }

  .specs__row:first-child {
    border-top: 0;
  }

  .specs dt {
    color: #444;
    font-weight: 600;
  }

  .specs dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .specs .mono {
    font-family: var(--oem-font);
    font-weight: 700;
  }

  .part__aka {
    margin: 0;
  }

  .rel {
    margin-top: 8px;
  }

  .rel .part__h2 {
    margin-bottom: 12px;
  }

  .rel :global(.plist__head) {
    position: static;
  }

  .rel :global(.prow) {
    content-visibility: visible;
  }

  .pn {
    display: grid;
    gap: 10px;
    margin-block: 20px;
  }

  .pn__link {
    display: grid;
    gap: 2px;
    min-height: 64px;
    padding: 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    color: inherit;
    text-decoration: none;
  }

  .pn__link:hover {
    border-color: var(--color-primary);
  }

  .pn__dir {
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .pn__name {
    font-weight: 600;
  }

  .req {
    margin-bottom: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .req > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 14px 16px;
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }

  .req > summary::-webkit-details-marker {
    display: none;
  }

  .req__chev {
    flex: none;
    transition: transform 0.15s;
  }

  .req[open] .req__chev {
    transform: rotate(180deg);
  }

  .req[open] > summary {
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .part__add {
      display: block;
    }

    .part__add :global(.padd__add) {
      min-height: 56px;
      height: 56px;
      min-width: 190px;
    }

    .pn {
      grid-template-columns: 1fr 1fr;
    }

    .pn__link--next {
      text-align: right;
    }

    /* photo column about 240-300px beside the title, number and specs */
    .part {
      gap: 0 32px;
      grid-template-columns: clamp(240px, 30vw, 300px) minmax(0, 1fr);
      grid-template-areas:
        'photo head'
        'photo rest';
      grid-template-rows: auto 1fr;
      align-items: start;
    }

    .part__photo {
      position: sticky;
      top: calc(var(--store-stick) + 16px);
      padding-top: 6px;
    }

    .part__rest {
      margin-top: 16px;
    }
  }

  @media (min-width: 1024px) {
    .part {
      gap: 0 48px;
    }
  }
</style>
