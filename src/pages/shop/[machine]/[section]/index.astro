---
// Section page: one section of the catalog as a dense list with search,
// filters and quantity + Add on every row.
import type { GetStaticPaths } from 'astro';
import { getEntry } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import PartSearch from '../../../../components/PartSearch.astro';
import PartTable from '../../../../components/PartTable.astro';
import SectionTiles from '../../../../components/SectionTiles.astro';
import PartRequestForm from '../../../../components/PartRequestForm.astro';
import StoreDisclaimer from '../../../../components/StoreDisclaimer.astro';
import { getParts, getSections, machineUrl, mainNumber, partUrl, sectionUrl } from '../../../../lib/parts';
import { breadcrumbs, itemList } from '../../../../lib/schema';
import { site } from '../../../../config/site';
import '../../../../styles/store.css';

// Parts shop off (site.store.enabled): no pages.
export const getStaticPaths = (async () =>
  site.store.enabled
    ? (await getSections()).map((section) => ({
        params: { machine: section.data.machine.id, section: section.id },
        props: { section },
      }))
    : []) satisfies GetStaticPaths;

const { section } = Astro.props;
const machine = (await getEntry(section.data.machine))!;
const parts = await getParts({ section: section.id });
const allParts = await getParts();
const sections = await getSections(machine.id);
const others = sections.filter((s) => s.id !== section.id);
const title = section.data.title;

// Titles stay within 60 characters (search results cut them off): the shop name is added when it fits and
// left off when it does not, never the words "Packaging Machines".
const pageTitle = `${title} for VFFS Packaging Machines`;
const withShopName = `${pageTitle} | ${site.name}`.length <= 60;
const description = `${title} for VFFS packaging machines: ${parts.length} replacement parts listed by OEM or C&M part number. Add parts to a quote request.`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Parts Store', path: '/shop/' },
  { name: machine.data.name, path: machineUrl(machine.id) },
  { name: title, path: sectionUrl(section) },
];
const jsonLd = [
  breadcrumbs(crumbs),
  itemList(
    parts.map((p) => ({ name: `${p.data.name} (${mainNumber(p.data)})`, path: partUrl(p) })),
    `${title} for VFFS packaging machines`,
  ),
];
---

<Base title={pageTitle} brand={withShopName} description={description} jsonLd={jsonLd}>
  <div class="storebar">
    <div class="container container--wide"><PartSearch variant="bar" /></div>
  </div>

  <div class="container container--wide sec">
    <div class="crumbs-desktop"><Breadcrumbs items={crumbs} /></div>
    <a class="back-link" href={machineUrl(machine.id)}>‹ {machine.data.name}</a>

    <header class="sec__head">
      <p class="eyebrow">Replacement parts for VFFS packaging machines</p>
      <h1>{title} for VFFS packaging machines</h1>
      <p class="lead">{section.data.blurb} Find your part by its OEM part number or C&amp;M number.</p>
    </header>

    <PartTable parts={parts} sections={[section]} lockSection eager={6} />

    <section class="sec__others" aria-labelledby="others-title">
      <h2 id="others-title">Other sections</h2>
      <SectionTiles sections={others} parts={allParts} />
    </section>

    <PartRequestForm />
    <StoreDisclaimer />
  </div>
</Base>

<style>
  .sec {
    display: grid;
    gap: 0;
    padding-block: 8px 40px;
  }

  .sec__head h1 {
    margin-bottom: 10px;
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 2.75rem);
  }

  .sec__head .eyebrow {
    margin-bottom: 10px;
    padding: 5px 12px;
    font-size: 0.875rem;
  }

  /* phones: the back link above the title already names the machine */
  @media (max-width: 767px) {
    .sec__head .eyebrow {
      display: none;
    }
  }

  .sec__head .lead {
    margin-bottom: 20px;
    font-size: 1rem;
  }

  .sec__others {
    margin-block: 36px 28px;
  }

  .sec__others h2 {
    font-size: 1.35rem;
  }

  .sec :global(.part-request) {
    margin-bottom: 20px;
  }
</style>
