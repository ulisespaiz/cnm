---
// Placeholder store home: replaced by the parts store build.
import Base from '../../layouts/Base.astro';
import PartCard from '../../components/PartCard.astro';
import { getParts, getSections, sectionUrl } from '../../lib/parts';

const sections = await getSections();
const parts = await getParts();
---

<Base title="Hayssen VFFS Replacement Parts" description="Replacement parts for Hayssen VFFS machines. Search by Hayssen part number and request a quote.">
  <section class="section">
    <div class="container">
      <h1>Parts Catalog</h1>
      <ul>
        {sections.map((s) => <li><a href={sectionUrl(s)}>{s.data.title}</a></li>)}
      </ul>
      <div class="grid">
        {parts.map((p) => <PartCard part={p} />)}
      </div>
    </div>
  </section>
</Base>
