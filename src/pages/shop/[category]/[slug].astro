---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ProductCard from '../../../components/ProductCard.astro';
import AddToQuote from '../../../components/AddToQuote.astro';
import { getProducts, productUrl, categoryUrl } from '../../../lib/content';
import { breadcrumbs, product as productSchema } from '../../../lib/schema';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((p) => ({
    params: { category: p.data.category.id, slug: p.id },
    props: { product: p },
  }));
}) satisfies GetStaticPaths;

const { product } = Astro.props;
const { data } = product;
const category = await getEntry(data.category);
if (!category) throw new Error(`Unknown category "${data.category.id}" on product "${product.id}"`);

const { Content } = await render(product);
const url = productUrl(product);
const related = (await getProducts(category.id)).filter((p) => p.id !== product.id).slice(0, 3);
const schemaImages = await Promise.all(
  data.images.map(async (img) => (await getImage({ src: img.src, width: 1200 })).src),
);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Shop', path: '/shop/' },
  { name: category.data.title, path: categoryUrl(category.id) },
  { name: data.title, path: url },
];
---

<Base
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.summary}
  image={schemaImages[0]}
  jsonLd={[
    breadcrumbs(crumbs),
    productSchema({ name: data.title, description: data.summary, path: url, images: schemaImages }),
  ]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={crumbs} />

      <div class="product">
        <div class="product__gallery">
          {data.images.length ? (
            data.images.map((img, i) => (
              <Image
                src={img.src}
                alt={img.alt}
                widths={[400, 700, 1000]}
                sizes="(min-width: 900px) 560px, 100vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            ))
          ) : (
            <div class="product__placeholder" aria-hidden="true"></div>
          )}
        </div>

        <div class="product__info">
          <h1>{data.title}</h1>
          <p class="product__summary">{data.summary}</p>

          <AddToQuote id={product.id} title={data.title} url={url} options={data.options} />

          {data.specs.length > 0 && (
            <table class="specs">
              <caption class="visually-hidden">Specifications</caption>
              <tbody>
                {data.specs.map((s) => (
                  <tr>
                    <th scope="row">{s.label}</th>
                    <td>{s.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      </div>

      <div class="prose product__body">
        <Content />
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <h2>More in {category.data.title}</h2>
        <div class="grid">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .product {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 900px) {
    .product {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
    }

    .product__info {
      position: sticky;
      top: 88px;
    }
  }

  /* Swipeable gallery on phones, stacked on desktop */
  .product__gallery {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }

  .product__gallery img,
  .product__placeholder {
    scroll-snap-align: center;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  @media (min-width: 900px) {
    .product__gallery {
      grid-auto-flow: row;
      overflow: visible;
      margin: 0;
      padding: 0;
    }
  }

  .product__summary {
    font-size: 1.1rem;
  }

  .specs {
    width: 100%;
    margin-top: 24px;
    border-collapse: collapse;
  }

  .specs th,
  .specs td {
    padding: 10px 0;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .specs th {
    width: 40%;
    color: var(--color-muted);
    font-weight: 600;
  }

  .product__body {
    margin-top: 40px;
  }
</style>
