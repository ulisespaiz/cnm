---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FeaturedParts from '../components/FeaturedParts.astro';
import { site } from '../config/site';
import { getEquipment, getServices, serviceUrl } from '../lib/content';
import { getParts, getSections, sectionUrl } from '../lib/parts';
import { faqPage } from '../lib/schema';
import banner from '../assets/work/our-work-2.jpg';
import shopPhoto from '../assets/site/front-office-cnm.jpeg';
import finishing from '../assets/work/our-work-1.jpg';
import machiningCenter from '../assets/work/our-work-2.jpg';
import lathe from '../assets/work/our-work-6.jpg';
import waterjet from '../assets/equipment/Flow-Mach-500-Waterjet-Cutting-Machine.jpg';
import laser from '../assets/equipment/Laser-Cutting-Services.jpg';
import verticalMill from '../assets/equipment/CNC-Vertical-Milling-Machine.jpg';

// Parts shop switch (site.store.enabled): off hides every shop block on this page.
const shopOn = site.store.enabled;
const services = await getServices();
const machines = await getEquipment();
const parts = shopOn ? await getParts() : [];
const sections = shopOn
  ? (await getSections('hayssen-vffs')).map((s) => ({
      title: s.data.title,
      href: sectionUrl(s),
      count: parts.filter((p) => p.data.section.id === s.id).length,
    }))
  : [];
// Owner's headline: "25 years of precision" (fixed, not computed).
const yearsInBusiness = 25;

// Real C&M shop photos only, each captioned for the machine it shows.
const work = [
  { src: finishing, title: 'Wide-Belt Finishing', text: 'Timesavers 32 RB Series wide-belt machine for deburring and finishing metal parts.' },
  { src: machiningCenter, title: 'CNC Machining Center', text: 'Vertical machining center with Kurt vises holding the workpieces.' },
  { src: lathe, title: 'Engine Lathe', text: 'Sharp 22120B engine lathe with digital readout for turning cylindrical components.' },
  { src: waterjet, title: 'Waterjet Cutting', text: 'Flow waterjet cutting table in our Salinas shop.' },
  { src: laser, title: 'Fiber Laser Cutting', text: 'Fiber laser cutting system for stainless steel, aluminum, brass and mild steel.' },
  { src: verticalMill, title: 'CNC Vertical Mill', text: 'CNC vertical milling machine for precision milling in our shop.' },
];

const faqs = [
  {
    q: 'What services do you offer?',
    a: 'We offer a range of machining services including CNC milling, turning, fabrication, and custom part manufacturing. Our team is skilled in precision engineering for various industries.',
  },
  ...(shopOn
    ? [
        {
          q: 'Do you sell replacement parts for Hayssen machines?',
          a: `Yes. Our parts catalog lists ${parts.length} replacement parts for Hayssen VFFS machines, searchable by Hayssen part number. If your part is not listed, send us the number and we will quote it.`,
        },
      ]
    : []),
  {
    q: 'What materials do you use?',
    a: 'We work with a variety of materials including metals (aluminum, steel, titanium) and plastics. If you have specific material requirements, feel free to reach out.',
  },
  {
    q: 'How do I request a quote?',
    a: shopOn
      ? `Add parts or services to your quote list and send it from our quote page, email us the details of your project, or call us directly at ${site.phone}. ${site.replyTime}.`
      : `Use our quote page to tell us what you need (a drawing, sample or part number is fine), email us the details, or call us directly at ${site.phone}. ${site.replyTime}.`,
  },
  {
    q: 'What is your typical turnaround time?',
    a: 'Our standard turnaround time depends on the complexity of the project. We strive to complete orders efficiently, with custom quotes provided for rush orders.',
  },
];
---

<Base
  title={`${site.legalName.replace(/\.$/, '')} | Machine Shop in Salinas, CA`}
  description={site.description}
  jsonLd={[faqPage(faqs)]}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Founded in {site.founded}</p>
      <h1>{yearsInBusiness} years of <span class="mark">precision.</span><br /> Still your machine shop.</h1>
      <p class="lead">
        {shopOn ? (
          <>
            Custom machining &amp; fabrication services, and a parts store with {parts.length} replacement parts for Hayssen
            VFFS machines.
          </>
        ) : (
          <>Custom machining and fabrication, plus replacement parts made to your drawing, sample or part number for food processing and packaging equipment.</>
        )}
      </p>

      {shopOn && (
        <form class="part-search" action="/shop/" method="get" role="search">
          <label for="hero-q">Search by Hayssen part #</label>
          <div class="part-search__row">
            <input
              id="hero-q"
              name="q"
              type="search"
              placeholder="e.g. 03187A0897"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              enterkeyhint="search"
            />
            <button class="btn btn--red" type="submit">Search</button>
          </div>
        </form>
      )}

      <div class="hero__actions">
        <a class="btn btn--dark" href="/quote/">Get a Quote</a>
        {shopOn ? (
          <a class="btn btn--outline" href="/shop/">Browse the Store</a>
        ) : (
          <a class="btn btn--outline" href="/services/">Our Services</a>
        )}
      </div>
      <dl class:list={['stats', { 'stats--3': !shopOn }]}>
        <div><dt>Years in business</dt><dd>{yearsInBusiness}+</dd></div>
        <div><dt>Precision machines</dt><dd>{machines.length}</dd></div>
        <div><dt>Core services</dt><dd>{services.length}</dd></div>
        {shopOn && <div class="stats__live"><dt>Parts in the store</dt><dd>{parts.length}</dd></div>}
      </dl>
    </div>
  </section>

  <section class="banner">
    <Image
      src={banner}
      alt="CNC vertical machining center with Kurt vises and the C&M logo on the door, inside the C&M shop"
      widths={[640, 1024, 1280]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="banner__overlay">
      <div class="container">
        <p class="banner__title">Manufacturing solutions you can count on</p>
      </div>
    </div>
  </section>

  {shopOn && (
    <section class="section">
      <div class="container">
        <div class="split-head">
          <div>
            <p class="eyebrow">Parts Store</p>
            <h2>The smarter way to get your <span class="text-blue">parts.</span></h2>
          </div>
          <p class="lead">
            Replacement parts for Hayssen VFFS machines, made to match your part number, sample or print. Search by
            Hayssen part number, add what you need to your quote list, and send it. Nothing to pay online.
          </p>
        </div>

        <div class="store">
          <div class="store__count">
            <p class="store__eyebrow">Parts catalog</p>
            <p class="store__num">{parts.length}</p>
            <p class="store__label">replacement parts for Hayssen VFFS machines, in {sections.length} sections</p>
            <div class="store__actions">
              <a class="btn btn--red" href="/shop/">Browse all parts</a>
              <a class="btn btn--light" href="/quote/#bulk">Paste a part list</a>
            </div>
          </div>
          <ul class="store__sections" aria-label="Parts sections">
            {sections.map((sec) => (
              <li>
                <a href={sec.href}>
                  <span class="store__sec-title">{sec.title}</span>
                  <span class="store__sec-count">{sec.count} parts <span aria-hidden="true">→</span></span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <h3 class="featured__title">Featured parts</h3>
        <div class="featured">
          <FeaturedParts />
        </div>
        <div class="featured__actions">
          <a class="btn btn--dark" href="/quote/#bulk">Paste a part list</a>
          <a class="btn btn--outline" href="/shop/">Browse all parts</a>
        </div>

        <div class="bento">
          <article class="bento__card">
            <h3>Save time without sacrificing quality</h3>
            <p class="muted">Skip the middleman. Order directly from a machine shop founded in {site.founded}. {site.store.madeTo}.</p>
          </article>
          <article class="bento__card">
            <h3>3 steps to your part</h3>
            <ol class="steps">
              <li>Search by Hayssen part #</li>
              <li>Send your quote request</li>
              <li>Pick up in {site.address.city}, or ask about shipping</li>
            </ol>
          </article>
          <article class="bento__card">
            <h3>Quote support</h3>
            <p class="muted">{site.replyTime} for quotes, orders, and custom part requests.</p>
          </article>
          <article class="bento__card bento__card--blue">
            <h3>Focus on running your operation, not hunting for parts</h3>
            <ul class="ticks ticks--light">
              <li>No complicated ordering system</li>
              <li>Fully customizable orders</li>
              <li>Local pickup, or ask about shipping</li>
            </ul>
            <a class="btn btn--light" href="/shop/">Shop All Parts</a>
          </article>
        </div>
      </div>
    </section>
  )}

  <section class="section section--alt">
    <div class="container about-split">
      <div>
        <p class="eyebrow">Who we are</p>
        <h2>Precision-driven expertise, backed by 30+ years of industry experience, focused on <span class="text-blue">manufacturing excellence</span></h2>
        <p class="lead">
          {site.legalName} delivers tailored, high-quality solutions that exceed expectations. From water-jet cutting
          and laser cutting to custom fabrication and blueprint-based projects, we handle work of any scale and
          complexity. Our skilled team combines advanced machinery with craftsmanship to turn your concepts into
          reality.
        </p>
        <div class="hero__actions">
          <a class="btn btn--dark" href="/about/">Learn more about us</a>
          <a class="btn btn--outline" href="/industries/food-processing-agriculture/">Food processing &amp; ag</a>
        </div>
      </div>
      <div class="about-split__media">
        <Image src={shopPhoto} alt={`The ${site.name} shop at ${site.address.street}, ${site.address.city}`} widths={[480, 800]} sizes="(min-width: 900px) 520px, 100vw" />
        <div class="since">
          <span>Founded in</span>
          <strong>{site.founded}</strong>
          <span>Family-owned in {site.address.city}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2>From raw to finished, we handle <span class="text-blue">every step of the process</span></h2>
      <div class="services">
        {services.map((s) => (
          <a class="service-card" href={serviceUrl(s)}>
            {s.data.image && (
              <Image src={s.data.image} alt={s.data.imageAlt ?? s.data.title} widths={[400, 640]} sizes="(min-width: 1000px) 280px, (min-width: 640px) 45vw, 100vw" />
            )}
            <div class="service-card__body">
              <h3>{s.data.title}</h3>
              <ul class="ticks">
                {s.data.capabilities.map((c) => <li>{c.name}</li>)}
              </ul>
              <span class="service-card__more">Read more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="center-head">
        <p class="eyebrow">Proof of our quality</p>
        <h2>Every cut, every part, every deadline — machined to your <span class="text-blue">exact specifications</span></h2>
        <p class="lead">At {site.legalName} we are committed to being your trusted partner, offering craftsmanship, innovation and reliability in every project.</p>
      </div>
      <ul class="gallery" tabindex="0" aria-label="Recent work samples">
        {work.map((w) => (
          <li>
            <Image src={w.src} alt={`${w.title}: ${w.text}`} widths={[360, 560]} sizes="(min-width: 900px) 360px, 80vw" />
            <h3>{w.title}</h3>
            <p class="muted">{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <div class="center-head">
        <p class="eyebrow">Common questions</p>
        <h2>Frequently asked <span class="text-blue">questions</span></h2>
      </div>
      {faqs.map((f, i) => (
        <details class="faq" open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

</Base>

<style>
  .hero {
    padding-block: clamp(40px, 8vw, 96px) clamp(32px, 6vw, 64px);
  }

  .hero h1 {
    max-width: 16ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  @media (max-width: 479px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  /* Part number search: a plain GET form, the store page runs the search */
  .part-search {
    max-width: 560px;
    margin: 0 0 20px;
  }

  .part-search label {
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
  }

  .part-search__row {
    display: flex;
    gap: 8px;
  }

  .part-search input {
    flex: 1;
    min-width: 0;
    min-height: var(--tap);
    padding: 0 14px;
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    color: inherit;
    font: 400 1rem/1.4 var(--font-body);
  }

  .part-search input:focus-visible {
    border-color: var(--color-primary);
    outline-offset: 0;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 36px 0 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-border);
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Parts store off: three stats. The last spans the row on phones, then three columns. */
  .stats--3 > div:last-child {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .stats--3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .stats--3 > div:last-child {
      grid-column: auto;
    }
  }

  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    padding: 18px 20px;
    background: var(--color-surface);
  }

  .stats dt {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stats dd {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .stats__live dd {
    color: var(--color-accent);
  }

  .banner {
    position: relative;
    max-height: 560px;
    overflow: hidden;
  }

  .banner img {
    width: 100%;
    height: clamp(260px, 45vw, 560px);
    object-fit: cover;
    object-position: 20% 25%;
  }

  .banner__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(24px, 5vw, 56px);
    background: linear-gradient(90deg, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.1) 70%);
  }

  .banner__title {
    max-width: 14ch;
    margin: 0;
    color: #fff;
    font-size: clamp(1.6rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .split-head {
    display: grid;
    gap: 16px;
    margin-bottom: 32px;
  }

  @media (min-width: 900px) {
    .split-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  /* Parts store block: catalog size + the six sections */
  .store {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .store {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  .store__count {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: #fff;
  }

  .store__eyebrow {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #dbe3ff;
  }

  .store__num {
    margin: 0;
    font-size: clamp(3.5rem, 12vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .store__label {
    max-width: 30ch;
    margin: 4px 0 20px;
    font-size: 1.1rem;
  }

  .store__actions,
  .featured__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 479px) {
    .store__actions .btn,
    .featured__actions .btn {
      flex: 1 1 100%;
    }
  }

  .store__sections {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 560px) {
    .store__sections {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .store__sections a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 72px;
    height: 100%;
    padding: 14px 18px;
    border-radius: var(--radius);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s;
  }

  .store__sections a:hover {
    box-shadow: var(--shadow);
  }

  .store__sec-title {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .store__sec-count {
    color: var(--color-primary);
    font-weight: 600;
  }

  .featured__title {
    margin: 36px 0 12px;
  }

  .featured__actions {
    margin-top: 20px;
  }

  .bento {
    display: grid;
    gap: 16px;
    margin-top: 40px;
  }

  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .bento__card {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .bento__card h3 {
    font-size: 1.2rem;
  }

  .bento__card--blue {
    background: var(--color-primary);
    color: #fff;
  }

  .ticks--light li::before {
    background: #fff;
  }

  .btn--light {
    background: #fff;
    border-color: #fff;
    color: var(--color-primary);
  }

  .btn--light:hover {
    background: var(--color-tint);
    border-color: var(--color-tint);
    color: var(--color-primary);
  }

  .steps {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 6px;
  }

  .featured {
    margin-top: 0;
  }

  .about-split {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-split {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .about-split__media {
    position: relative;
  }

  .about-split__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .since {
    position: absolute;
    right: 16px;
    bottom: -20px;
    display: grid;
    justify-items: center;
    padding: 18px 22px;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: #fff;
    text-align: center;
    font-size: 0.875rem;
  }

  .since strong {
    font-size: 2.2rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .services {
    display: grid;
    gap: 20px;
    margin-top: 12px;
  }

  @media (min-width: 640px) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .services {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s;
  }

  .service-card:hover {
    box-shadow: var(--shadow);
  }

  .service-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .service-card__body {
    padding: 20px;
  }

  .service-card__more {
    font-weight: 700;
    color: var(--color-primary);
  }

  .center-head {
    max-width: 760px;
    margin: 0 auto 32px;
    text-align: center;
  }

  .center-head .lead {
    margin-inline: auto;
  }

  /* Swipe on phones, grid on desktop */
  .gallery {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80%, 340px);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter) 8px;
    list-style: none;
  }

  .gallery li {
    scroll-snap-align: start;
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 12px;
  }

  .gallery h3 {
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  @media (min-width: 900px) {
    .gallery {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
      margin: 0;
      padding: 0;
    }
  }

  .faq-wrap {
    max-width: 820px;
  }

  .faq {
    margin-bottom: 12px;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 60px;
    padding: 14px 20px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-size: 1.2rem;
  }

  .faq[open] summary::after {
    content: '−';
  }

  .faq p {
    margin: 0;
    padding: 0 20px 18px;
    color: var(--color-muted);
  }
</style>
