---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
import { getEquipment, getServices, serviceTeaser, serviceUrl } from '../lib/content';
import { getParts, getSections, MAIN_MACHINE, sectionUrl } from '../lib/parts';
import { leadTime } from '../components/store';
import { faqPage } from '../lib/schema';
import banner from '../assets/work/our-work-2.jpg';
import shopPhoto from '../assets/site/front-office-cnm.jpeg';
import finishing from '../assets/work/our-work-1.jpg';
import machiningCenter from '../assets/work/our-work-2.jpg';
import lathe from '../assets/work/our-work-6.jpg';
import waterjet from '../assets/equipment/Flow-Mach-500-Waterjet-Cutting-Machine.jpg';
import laser from '../assets/equipment/Laser-Cutting-Services.jpg';
import verticalMill from '../assets/equipment/CNC-Vertical-Milling-Machine.jpg';

// Parts shop switch (site.store.enabled): off hides every shop block on this page.
const shopOn = site.store.enabled;
const services = await getServices();
const machines = await getEquipment();
const parts = shopOn ? await getParts() : [];
const sections = shopOn
  ? (await getSections(MAIN_MACHINE)).map((s) => ({
      title: s.data.title,
      href: sectionUrl(s),
      count: parts.filter((p) => p.data.section.id === s.id).length,
    }))
  : [];

// "a, b and c"
const list = (items: string[]) => (items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items.at(-1)}`);

// The materials answer reads the service files' `materials` lists, so it never names a material the
// service pages do not (CONFIRM notes in those files say which are still unconfirmed).
const lower = (m: string) => m.toLowerCase();
const worked = [...new Set(services.filter((s) => s.id !== 'cutting').flatMap((s) => s.data.materials))];
const cutOnly = (services.find((s) => s.id === 'cutting')?.data.materials ?? []).filter((m) => !worked.includes(m));
const materialsAnswer =
  `We work with ${list(worked.map(lower))}` +
  (cutOnly.length ? `, and our cutting service also cuts ${list(cutOnly.map(lower))}` : '') +
  '. If you need another material, ask when you request a quote.';

// Real C&M shop photos only, each captioned for the machine it shows. `alt` says what the
// photo looks like; the caption beside it already names the machine, so the alt must not repeat it.
const work = [
  { src: finishing, alt: 'White machine with a dark safety door and a control panel, abrasive belts hanging beside it', title: 'Wide-Belt Finishing', text: 'Timesavers 32 RB Series wide-belt machine for deburring and finishing metal parts.' },
  { src: machiningCenter, alt: 'Open machine door with three blue vises on the table below the spindle', title: 'CNC Machining Center', text: 'Vertical machining center with Kurt vises holding the workpieces.' },
  { src: lathe, alt: 'Long lathe bed with a chuck, a tailstock and a digital readout, bar stock racked behind', title: 'Engine Lathe', text: 'Sharp 22120B engine lathe with digital readout for turning cylindrical components.' },
  { src: waterjet, alt: 'Large cutting table with a gantry carrying the C&M shop sign, in a corrugated-steel shop', title: 'Waterjet Cutting', text: 'Flow waterjet cutting table in our Salinas shop.' },
  { src: laser, alt: 'Black enclosure with a long slatted cutting table and a dust collector with six round filters', title: 'Fiber Laser Cutting', text: 'Fiber laser cutting system for stainless steel, aluminum, brass and mild steel.' },
  { src: verticalMill, alt: 'White and gray machine with a control panel and a window onto the work area', title: 'CNC Vertical Mill', text: 'CNC vertical milling machine for precision milling in our shop.' },
];

// Plain text: these answers also feed the FAQPage JSON-LD.
const faqs = [
  {
    q: 'What services do you offer?',
    a: 'We offer four services: CNC machining (milling and turning); cutting (laser, waterjet and shearing); welding and metal work (MIG and TIG welding, rolling, forming and bending); and custom metal fabrication, from your blueprints or without them.',
  },
  ...(shopOn
    ? [
        {
          q: 'Do you make replacement parts for VFFS packaging machines?',
          a: `Yes. Our parts catalog lists ${parts.length} replacement parts for vertical form fill seal (VFFS) packaging machines, matched by OEM part number and searchable by OEM part number or C&M number. If your part is not listed, send us the number, a sample or a print and we will quote it.`,
        },
      ]
    : []),
  {
    q: 'What materials do you use?',
    a: materialsAnswer,
  },
  {
    q: 'How do I request a quote?',
    a: shopOn
      ? `Add parts or services to your quote list and send it from our quote page, email us the details of your project, or call us directly at ${site.phone}. ${site.replyTime}.`
      : `Use our quote page to tell us what you need (a drawing, sample or part number is fine), email us the details, or call us directly at ${site.phone}. ${site.replyTime}.`,
  },
  {
    q: 'What is your typical turnaround time?',
    a: `${leadTime()}. ${site.replyTime}.`,
  },
];
---

<Base
  title={`${site.name} | CNC Machining & Fabrication in ${site.address.city}, CA`}
  description={site.description}
  jsonLd={[faqPage(faqs)]}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Machine shop in {site.address.city}, {site.address.region} · Since {site.founded}</p>
      <h1>Precision machining since <span class="mark">{site.founded}.</span><br /> Still your machine shop.</h1>
      <p class="lead">
        CNC machining, waterjet and laser cutting, welding and metal work, and custom metal fabrication.{' '}
        {shopOn ? (
          <>Plus {parts.length} replacement parts for vertical form fill seal (VFFS) packaging machines.</>
        ) : (
          <>Plus replacement parts made to your drawing, sample or part number for food processing and packaging equipment.</>
        )}
      </p>

      {shopOn && (
        <form class="part-search" action="/shop/" method="get" role="search">
          <label for="hero-q">Search by OEM or C&amp;M part number</label>
          <div class="part-search__row">
            <input
              id="hero-q"
              name="q"
              type="search"
              placeholder="e.g. 03187A0897"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              enterkeyhint="search"
            />
            <button class="btn" type="submit">Search</button>
          </div>
          <p class="part-search__miss">
            Part not listed? <a href="/quote/">Send us the number, a sample or a print</a> and we will quote it.{' '}
            {site.replyTime}.
          </p>
        </form>
      )}

      <div class="hero__actions">
        <a class="btn btn--red" href="/quote/">Get a Quote</a>
        {shopOn ? (
          <a class="btn btn--outline" href="/shop/">Browse parts</a>
        ) : (
          <a class="btn btn--outline" href="/services/">Our Services</a>
        )}
      </div>
      <dl class:list={['stats', { 'stats--3': !shopOn }]}>
        <div><dt>Founded</dt><dd>{site.founded}</dd></div>
        <div><dt>Key machines</dt><dd>{machines.length}</dd></div>
        <div><dt>Core services</dt><dd>{services.length}</dd></div>
        {shopOn && <div class="stats__live"><dt>Parts in the store</dt><dd>{parts.length}</dd></div>}
      </dl>
    </div>
  </section>

  <section class="section section--alt svc" id="services" aria-labelledby="services-title">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2 id="services-title">From raw stock to <span class="text-blue">finished part</span></h2>
      <ul class="svc__grid">
        {services.map((s) => (
          <li>
            <a class="svc__card" href={serviceUrl(s)}>
              <h3 class="svc__title">{s.data.title} <span class="svc__arrow" aria-hidden="true">→</span></h3>
              <p class="svc__teaser">{serviceTeaser(s)}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {shopOn && (
    <section class="section parts" id="parts" aria-labelledby="parts-title">
      <div class="container">
        <div class="split-head">
          <div>
            <p class="eyebrow">Parts</p>
            <h2 id="parts-title">Replacement parts for <span class="text-blue">VFFS packaging machines</span></h2>
          </div>
          <p class="lead">
            {site.store.madeTo}. Search by OEM or C&amp;M part number, add what you need to your quote list, and send
            it. Nothing to pay online.
          </p>
        </div>

        <div class="store">
          <div class="store__count">
            <p class="store__num">{parts.length}</p>
            <p class="store__label">replacement parts in {sections.length} sections</p>
            <a class="btn btn--light" href="/shop/">Browse all parts</a>
          </div>
          <ul class="store__sections" aria-label="Parts sections">
            {sections.map((sec) => (
              <li>
                <a href={sec.href}>
                  <span class="store__sec-title">{sec.title}</span>
                  <span class="store__sec-count">{sec.count} parts</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="store__miss">
          <div>
            <h3>Part not listed?</h3>
            <p class="muted">
              Send us the part number, a sample or a print and we will quote it. {site.replyTime}.
            </p>
          </div>
          <div class="store__miss-actions">
            <a class="btn btn--red" href="/quote/">Request a quote</a>
            <a class="btn btn--outline" href="/quote/#bulk">Paste a part list</a>
          </div>
        </div>
        <p class="store__legal">{site.store.disclaimer}</p>
      </div>
    </section>
  )}

  <section class="banner">
    <Image
      src={banner}
      alt="CNC vertical machining center with Kurt vises and the C&M logo on the door, inside the C&M shop"
      widths={[640, 768, 1024, 1280]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="banner__overlay">
      <div class="container">
        <p class="banner__title">Manufacturing solutions you can count on</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-split">
      <div>
        <p class="eyebrow">Who we are</p>
        <h2>Precision-driven expertise, in business since {site.founded}, focused on <span class="text-blue">manufacturing excellence</span></h2>
        <p class="lead">
          {site.legalName} delivers tailored, high-quality solutions that exceed expectations. From waterjet and laser
          cutting to custom fabrication and blueprint-based projects, we handle work of any scale and complexity. Our
          skilled team combines advanced machinery with craftsmanship to turn your concepts into reality.
        </p>
        <p>
          Based in {site.address.city}, we serve customers across the Monterey Bay area and beyond.
          <a class="areas-link" href="/service-areas/">See the areas we serve</a>.
        </p>
        <div class="hero__actions">
          <a class="btn" href="/about/">Learn more about us</a>
          <a class="btn btn--outline" href="/industries/food-processing-agriculture/">Food processing &amp; ag</a>
        </div>
      </div>
      <div class="about-split__media">
        <Image
          src={shopPhoto}
          alt={`Front of our building at ${site.address.street}, ${site.address.city}, with the C&M sign and an open roll-up door`}
          widths={[480, 800]}
          sizes="(min-width: 900px) 520px, 100vw"
        />
        <div class="since">
          <span>Founded in</span>
          <strong>{site.founded}</strong>
          <span>Family-owned in {site.address.city}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="center-head">
        <p class="eyebrow">Inside our shop</p>
        <h2>Real photos of the machines in our <span class="text-blue">{site.address.city} shop</span></h2>
        <p class="lead">A few of the machines we run. <a href="/our-machinery/">See all our machinery</a>.</p>
      </div>
      <ul class="gallery" tabindex="0" aria-label="Machines in our shop">
        {work.map((w) => (
          <li>
            <Image src={w.src} alt={w.alt} widths={[360, 560]} sizes="(min-width: 900px) 360px, 80vw" />
            <h3>{w.title}</h3>
            <p class="muted">{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <div class="center-head">
        <p class="eyebrow">Common questions</p>
        <h2>Frequently asked <span class="text-blue">questions</span></h2>
      </div>
      {faqs.map((f, i) => (
        <details class="faq" open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

</Base>

<style>
  .hero {
    padding-block: clamp(40px, 8vw, 96px) clamp(32px, 6vw, 64px);
  }

  .hero h1 {
    /* em, not ch: ch follows the font, so the fallback and Geist gave different widths and rewrapped the headline */
    max-width: 11.25em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  @media (max-width: 479px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  /* Part number search: a plain GET form, the store page runs the search */
  .part-search {
    max-width: 560px;
    margin: 0 0 20px;
  }

  .part-search label {
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
  }

  .part-search__row {
    display: flex;
    gap: 8px;
  }

  .part-search input {
    flex: 1;
    min-width: 0;
    min-height: var(--tap);
    padding: 0 14px;
    border: 2px solid var(--color-field-border);
    border-radius: var(--radius);
    background: #fff;
    color: inherit;
    font: 400 1rem/1.4 var(--font-body);
  }

  .part-search input:focus-visible {
    border-color: var(--color-primary);
    outline-offset: 0;
  }

  .part-search__miss {
    margin: 10px 0 0;
    text-wrap: pretty;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .part-search__miss a {
    font-weight: 600;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 36px 0 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-border);
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Parts store off: three stats. The last spans the row on phones, then three columns. */
  .stats--3 > div:last-child {
    grid-column: 1 / -1;
  }

  @media (min-width: 768px) {
    .stats--3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .stats--3 > div:last-child {
      grid-column: auto;
    }
  }

  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    padding: 18px 20px;
    background: var(--color-surface);
  }

  .stats dt {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stats dd {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .stats__live dd {
    color: var(--color-accent);
  }

  .banner {
    position: relative;
    max-height: 560px;
    overflow: hidden;
  }

  .banner img {
    width: 100%;
    height: clamp(260px, 45vw, 560px);
    object-fit: cover;
    object-position: 20% 25%;
  }

  .banner__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(24px, 5vw, 56px);
    background: linear-gradient(90deg, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.1) 70%);
  }

  .banner__title {
    max-width: 14ch;
    margin: 0;
    color: #fff;
    font-size: clamp(1.6rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.6);
  }

  .split-head {
    display: grid;
    gap: 16px;
    margin-bottom: 32px;
  }

  @media (min-width: 900px) {
    .split-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  /* Parts store block: catalog size + the catalog sections */
  .store {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 900px) {
    .store {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  .store__count {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 4px 16px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: #fff;
  }

  .store__num {
    margin: 0;
    font-size: clamp(3rem, 10vw, 5.5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .store__label {
    max-width: 22ch;
    margin: 0;
    font-size: 1.1rem;
  }

  .store__count .btn {
    grid-column: 1 / -1;
    margin-top: 16px;
  }

  @media (min-width: 900px) {
    .store__count {
      grid-template-columns: 1fr;
      align-content: center;
      padding: 28px;
    }

    .store__label {
      max-width: 30ch;
    }

    .store__count .btn {
      justify-self: start;
    }
  }

  /* White button on the blue card: blue text on white is 8.6:1 */
  .btn--light {
    background: #fff;
    border-color: #fff;
    color: var(--color-primary);
  }

  .btn--light:hover {
    background: var(--color-tint);
    border-color: var(--color-tint);
    color: var(--color-primary);
  }

  /* Two columns from phone width: eight sections make a 2x4 grid, not eight full-width rows */
  .store__sections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .store__sections a {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 72px;
    height: 100%;
    padding: 12px 14px;
    border-radius: var(--radius);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s;
  }

  .store__sections a:hover {
    box-shadow: var(--shadow);
  }

  .store__sec-title {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .store__sec-count {
    color: var(--color-primary);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  @media (min-width: 560px) {
    .store__sections a {
      padding: 14px 18px;
    }

    .store__sec-title {
      font-size: 1.1rem;
    }
  }

  /* For visitors whose part is not in the catalog: the quote is the way in */
  .store__miss {
    display: grid;
    gap: 16px;
    margin-top: 16px;
    padding: 24px;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .store__miss h3 {
    margin-bottom: 4px;
  }

  .store__miss p {
    margin: 0;
    text-wrap: pretty;
  }

  .store__miss-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 479px) {
    .store__miss-actions .btn {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 768px) {
    .store__miss {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  .store__legal {
    margin: 16px 0 0;
    color: var(--color-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .about-split {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-split {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  /* One box even when the sentence wraps: the tap target is 44px+ tall and the text stays where it was */
  .areas-link {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
  }

  .about-split__media {
    position: relative;
  }

  .about-split__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .since {
    position: absolute;
    right: 16px;
    bottom: -20px;
    display: grid;
    justify-items: center;
    padding: 18px 22px;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: #fff;
    text-align: center;
    font-size: 0.875rem;
  }

  .since strong {
    font-size: 2.2rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* Compact services row right under the hero: title, one-sentence teaser, the whole card is the link */
  .svc__grid {
    display: grid;
    gap: 12px;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .svc__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (min-width: 1100px) {
    .svc__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .svc__card {
    display: block;
    height: 100%;
    padding: 18px 20px;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: var(--color-bg);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s, border-color 0.15s;
  }

  .svc__card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow);
  }

  .svc__title {
    margin-bottom: 6px;
    font-size: 1.2rem;
  }

  .svc__arrow {
    color: var(--color-primary);
  }

  .svc__teaser {
    margin: 0;
    color: var(--color-muted);
  }

  .center-head {
    max-width: 760px;
    margin: 0 auto 32px;
    text-align: center;
  }

  .center-head .lead {
    margin-inline: auto;
  }

  /* Swipe on phones, grid on desktop */
  .gallery {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80%, 340px);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter) 8px;
    list-style: none;
  }

  .gallery li {
    scroll-snap-align: start;
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 12px;
  }

  .gallery h3 {
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  @media (min-width: 900px) {
    .gallery {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
      margin: 0;
      padding: 0;
    }
  }

  .faq-wrap {
    max-width: 820px;
  }

  .faq {
    margin-bottom: 12px;
    border-radius: var(--radius);
