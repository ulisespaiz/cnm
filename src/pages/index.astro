---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';
import { getEquipment, getProducts, getServices, serviceUrl } from '../lib/content';
import { faqPage } from '../lib/schema';
import banner from '../assets/site/metal-piece-4.png';
import shopPhoto from '../assets/work/our-work-3.jpg';
import work1 from '../assets/work/our-work-1.jpg';
import work2 from '../assets/work/our-work-2.jpg';
import work3 from '../assets/work/our-work-3.jpg';
import work4 from '../assets/work/our-work-4.jpg';
import work5 from '../assets/work/our-work-5.jpg';
import work6 from '../assets/work/our-work-6.jpg';

const services = await getServices();
const machines = await getEquipment();
const featured = (await getProducts()).filter((p) => p.data.featured).slice(0, 4);
const yearsInBusiness = new Date().getFullYear() - 2002;

const work = [
  { src: work1, title: 'Engine Lathe', text: 'Sharp precision engine lathe with digital readout for turning and machining cylindrical metal components.' },
  { src: work2, title: 'Precision Drilling', text: 'Sub-millimeter CNC drill bit making precise contact with a metal surface for micro-machining operations.' },
  { src: work3, title: 'Vertical Milling', text: 'Manual vertical mill machining a clamped metal workpiece on a T-slot table in our shop.' },
  { src: work4, title: 'CNC Routing', text: 'Technician overseeing a CNC router cutting precise patterns into sheet metal.' },
  { src: work5, title: 'CNC Machining Center', text: 'Vertical machining center in operation with Kurt vises securing workpieces and coolant mist during the cut.' },
  { src: work6, title: 'Surface Finishing', text: 'Timesavers 32 RB Series wide belt machine for precision deburring and surface finishing of sheet metal parts.' },
];

const faqs = [
  {
    q: 'What services do you offer?',
    a: 'We offer a range of machining services including CNC milling, turning, fabrication, and custom part manufacturing. Our team is skilled in precision engineering for various industries.',
  },
  {
    q: 'What materials do you use?',
    a: 'We work with a variety of materials including metals (aluminum, steel, titanium) and plastics. If you have specific material requirements, feel free to reach out.',
  },
  {
    q: 'How do I request a quote?',
    a: `Add parts or services to your quote list and send it from our quote page, email us the details of your project, or call us directly at ${site.phone}.`,
  },
  {
    q: 'What is your typical turnaround time?',
    a: 'Our standard turnaround time depends on the complexity of the project. We strive to complete orders efficiently, with custom quotes provided for rush orders.',
  },
];
---

<Base
  title={`${site.legalName.replace(/\.$/, '')} | Machine Shop in Salinas, CA`}
  description={site.description}
  jsonLd={[faqPage(faqs)]}
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Trusted since 2002</p>
      <h1>{yearsInBusiness} years of <span class="mark">precision.</span><br /> Still your machine shop.</h1>
      <p class="lead">
        Custom machining &amp; fabrication services — and now a full parts store. From one-off industrial components
        to ready-to-ship stock.
      </p>
      <div class="hero__actions">
        <a class="btn btn--dark" href="/quote/">Get a Quote</a>
        <a class="btn btn--red" href="/shop/">Browse the Store</a>
      </div>
      <dl class="stats">
        <div><dt>Years in business</dt><dd>{yearsInBusiness}+</dd></div>
        <div><dt>Precision machines</dt><dd>{machines.length}</dd></div>
        <div><dt>Core services</dt><dd>{services.length}</dd></div>
        <div class="stats__live"><dt>Parts store</dt><dd>Now live</dd></div>
      </dl>
    </div>
  </section>

  <section class="banner">
    <Image src={banner} alt="Precision-machined metal part" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="banner__overlay">
      <div class="container">
        <p class="banner__title">Manufacturing solutions you can count on</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="split-head">
        <div>
          <p class="eyebrow">Parts Store</p>
          <h2>The smarter way to get your <span class="text-blue">parts.</span></h2>
        </div>
        <p class="lead">
          When your machines need parts, your shop needs a source you can trust. Browse our catalog of
          precision-machined components, stock materials, and specialty hardware — shipped fast or ready for local
          pickup.
        </p>
      </div>

      <div class="bento">
        <article class="bento__card">
          <h3>Save time without sacrificing quality</h3>
          <p class="muted">Skip the middleman. Order directly from a machine shop that has been in business since 2002. Every part is made or sourced to spec.</p>
        </article>
        <article class="bento__card">
          <h3>3 steps to your part</h3>
          <ol class="steps">
            <li>Browse the catalog</li>
            <li>Send your quote request</li>
            <li>Pick up or receive it</li>
          </ol>
        </article>
        <article class="bento__card">
          <h3>24-hour order support</h3>
          <p class="muted">Our team responds within 24 hours to quotes, orders, and custom part requests.</p>
        </article>
        <article class="bento__card bento__card--blue">
          <h3>Focus on running your operation, not hunting for parts</h3>
          <ul class="ticks ticks--light">
            <li>No complicated ordering system</li>
            <li>Fully customizable orders</li>
            <li>Local pickup or fast shipping</li>
          </ul>
          <a class="btn btn--light" href="/shop/">Shop All Parts</a>
        </article>
      </div>

      {featured.length > 0 && (
        <div class="grid featured">
          {featured.map((p) => <ProductCard product={p} />)}
        </div>
      )}
    </div>
  </section>

  <section class="section section--alt">
    <div class="container about-split">
      <div>
        <p class="eyebrow">Who we are</p>
        <h2>Precision-driven expertise, backed by 30+ years of industry experience, focused on <span class="text-blue">manufacturing excellence</span></h2>
        <p class="lead">
          {site.legalName} delivers tailored, high-quality solutions that exceed expectations. From water-jet cutting
          and laser cutting to custom fabrication and blueprint-based projects, we handle work of any scale and
          complexity. Our skilled team combines advanced machinery with craftsmanship to turn your concepts into
          reality.
        </p>
        <a class="btn btn--dark" href="/about/">Learn more about us</a>
      </div>
      <div class="about-split__media">
        <Image src={shopPhoto} alt="Vertical milling machine in the C&M shop" widths={[480, 800]} sizes="(min-width: 900px) 520px, 100vw" />
        <div class="since">
          <span>Since</span>
          <strong>2002</strong>
          <span>Family-owned in {site.address.city}</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2>From raw to finished, we handle <span class="text-blue">every step of the process</span></h2>
      <div class="services">
        {services.map((s) => (
          <a class="service-card" href={serviceUrl(s)}>
            {s.data.image && (
              <Image src={s.data.image} alt={s.data.imageAlt ?? s.data.title} widths={[400, 640]} sizes="(min-width: 1000px) 280px, (min-width: 640px) 45vw, 100vw" />
            )}
            <div class="service-card__body">
              <h3>{s.data.title}</h3>
              <ul class="ticks">
                {s.data.capabilities.map((c) => <li>{c.name}</li>)}
              </ul>
              <span class="service-card__more">Read more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="center-head">
        <p class="eyebrow">Proof of our quality</p>
        <h2>Every cut, every part, every deadline — machined to your <span class="text-blue">exact specifications</span></h2>
        <p class="lead">At {site.legalName} we are committed to being your trusted partner, offering craftsmanship, innovation and reliability in every project.</p>
      </div>
      <ul class="gallery">
        {work.map((w) => (
          <li>
            <Image src={w.src} alt={w.title} widths={[360, 560]} sizes="(min-width: 900px) 360px, 80vw" />
            <h3>{w.title}</h3>
            <p class="muted">{w.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container faq-wrap">
      <div class="center-head">
        <p class="eyebrow">Common questions</p>
        <h2>Frequently asked <span class="text-blue">questions</span></h2>
      </div>
      {faqs.map((f, i) => (
        <details class="faq" open={i === 0}>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    padding-block: clamp(40px, 8vw, 96px) clamp(32px, 6vw, 64px);
  }

  .hero h1 {
    max-width: 16ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  @media (max-width: 479px) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    margin: 36px 0 0;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-border);
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stats > div {
    display: flex;
    flex-direction: column-reverse;
    padding: 18px 20px;
    background: var(--color-surface);
  }

  .stats dt {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .stats dd {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .stats__live dd {
    color: var(--color-accent);
  }

  .banner {
    position: relative;
    max-height: 560px;
    overflow: hidden;
  }

  .banner img {
    width: 100%;
    height: clamp(260px, 45vw, 560px);
    object-fit: cover;
  }

  .banner__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding-bottom: clamp(24px, 5vw, 56px);
    background: linear-gradient(90deg, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0.1) 70%);
  }

  .banner__title {
    max-width: 14ch;
    margin: 0;
    color: #fff;
    font-size: clamp(1.6rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .split-head {
    display: grid;
    gap: 16px;
    margin-bottom: 32px;
  }

  @media (min-width: 900px) {
    .split-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .bento {
    display: grid;
    gap: 16px;
  }

  @media (min-width: 768px) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .bento {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .bento__card {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .bento__card h3 {
    font-size: 1.2rem;
  }

  .bento__card--blue {
    background: var(--color-primary);
    color: #fff;
  }

  .ticks--light li::before {
    background: #fff;
  }

  .btn--light {
    background: #fff;
    border-color: #fff;
    color: var(--color-primary);
  }

  .btn--light:hover {
    background: var(--color-tint);
    border-color: var(--color-tint);
  }

  .steps {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 6px;
  }

  .featured {
    margin-top: 24px;
  }

  .about-split {
    display: grid;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .about-split {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .about-split__media {
    position: relative;
  }

  .about-split__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .since {
    position: absolute;
    right: 16px;
    bottom: -20px;
    display: grid;
    justify-items: center;
    padding: 18px 22px;
    border-radius: var(--radius);
    background: var(--color-primary);
    color: #fff;
    text-align: center;
    font-size: 0.85rem;
  }

  .since strong {
    font-size: 2.2rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .services {
    display: grid;
    gap: 20px;
    margin-top: 12px;
  }

  @media (min-width: 640px) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .services {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .service-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s;
  }

  .service-card:hover {
    box-shadow: var(--shadow);
  }

  .service-card img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .service-card__body {
    padding: 20px;
  }

  .service-card__more {
    font-weight: 700;
    color: var(--color-primary);
  }

  .center-head {
    max-width: 760px;
    margin: 0 auto 32px;
    text-align: center;
  }

  .center-head .lead {
    margin-inline: auto;
  }

  /* Swipe on phones, grid on desktop */
  .gallery {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80%, 340px);
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    margin: 0 calc(var(--gutter) * -1);
    padding: 0 var(--gutter) 8px;
    list-style: none;
  }

  .gallery li {
    scroll-snap-align: start;
  }

  .gallery img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 12px;
  }

  .gallery h3 {
    font-size: 1.1rem;
    margin-bottom: 4px;
  }

  @media (min-width: 900px) {
    .gallery {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
      margin: 0;
      padding: 0;
    }
  }

  .faq-wrap {
    max-width: 820px;
  }

  .faq {
    margin-bottom: 12px;
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .faq summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    min-height: 60px;
    padding: 14px 20px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    font-size: 1.2rem;
  }

  .faq[open] summary::after {
    content: '−';
  }

  .faq p {
    margin: 0;
    padding: 0 20px 18px;
    color: var(--color-muted);
  }
</style>
