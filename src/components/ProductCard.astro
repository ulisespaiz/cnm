---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { productUrl } from '../lib/content';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const cover = product.data.images[0];
---

<a class="card" href={productUrl(product)}>
  {cover ? (
    <Image class="card__media" src={cover.src} alt={cover.alt} widths={[320, 480, 640]} sizes="(min-width: 900px) 280px, 100vw" />
  ) : (
    <div class="card__media" aria-hidden="true"></div>
  )}
  <div class="card__body">
    <h3>{product.data.title}</h3>
    <p class="muted">{product.data.summary}</p>
  </div>
</a>
