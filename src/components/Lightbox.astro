---
// Part photo with a "tap to enlarge" lightbox (<dialog>). The photo is shown
// at its native size at most; the lightbox goes to 2x native and no further.
// A thumbnail strip appears only when a part has more than one photo.
import '../styles/store.css';

interface Photo {
  src: string;
  width: number;
  height: number;
}

interface Props {
  photos: Photo[];
  alt: string;
}

const { photos, alt } = Astro.props;
const first = photos[0];
---

{
  first ? (
    <div class="photo" data-photo>
      <button type="button" class="photo__main part-thumb" data-lightbox-open aria-label={`Enlarge photo: ${alt}`}>
        <img src={first.src} width={first.width} height={first.height} alt={alt} decoding="async" fetchpriority="high" data-photo-main />
        <span class="photo__zoom" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5M11 8v6M8 11h6"></path></svg>
          Enlarge
        </span>
      </button>
      {photos.length > 1 && (
        <ul class="photo__thumbs" aria-label="More photos">
          {photos.map((p, i) => (
            <li>
              <button type="button" class="photo__thumb part-thumb" data-photo-thumb data-src={p.src} data-w={p.width} data-h={p.height} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Show photo ${i + 1} of ${photos.length}`}>
                <img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async" />
              </button>
            </li>
          ))}
        </ul>
      )}
      <dialog class="lightbox" data-lightbox aria-label={`Photo of ${alt}`}>
        <button type="button" class="iconbtn lightbox__close" data-lightbox-close aria-label="Close photo">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
        <div class="lightbox__scroll">
          <img class="lightbox__img" src={first.src} width={first.width} height={first.height} alt={alt} data-lightbox-img style={`width:min(100%, ${first.width * 2}px)`} />
        </div>
        <p class="lightbox__note">Photo taken in our shop.</p>
      </dialog>
    </div>
  ) : (
    <div class="photo">
      <div class="photo__main part-thumb"><span class="part-thumb__none">Photo coming soon</span></div>
    </div>
  )
}

<script>
  import '../scripts/lightbox';
</script>

<style>
  .photo {
    display: grid;
    gap: 10px;
    max-width: 300px;
  }

  .photo__main {
    position: relative;
    width: 100%;
    padding: 0;
    cursor: zoom-in;
  }

  /* never scaled past the file's own size */
  .photo__main img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
  }

  .photo__zoom {
    position: absolute;
    right: 8px;
    bottom: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.95);
    border: 1px solid var(--color-border);
    color: #111;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .photo__thumbs {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .photo__thumb {
    width: 60px;
    padding: 0;
    cursor: pointer;
  }

  .photo__thumb[aria-pressed='true'] {
    border-color: var(--color-primary);
    outline: 2px solid var(--color-primary);
  }

  .lightbox {
    width: min(96vw, 760px);
    max-width: none;
    max-height: 94vh;
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: #fff;
    overflow: hidden;
  }

  .lightbox[open] {
    display: flex;
    flex-direction: column;
  }

  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.7);
  }

  .lightbox__close {
    position: absolute;
    right: 8px;
    top: 8px;
    z-index: 2;
    background: rgb(255 255 255 / 0.95);
    border: 1px solid var(--color-border);
  }

  .lightbox__scroll {
    flex: 1;
    overflow: auto;
    display: grid;
    place-items: start center;
    padding: 56px 12px 8px;
    touch-action: pan-x pan-y pinch-zoom;
  }

  .lightbox__img {
    max-width: none;
    height: auto;
    background: #fff;
  }

  .lightbox__note {
    margin: 0;
    padding: 6px 16px 12px;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-align: center;
  }
</style>
