---
// Compact part card (photo, name, part numbers). Used by FeaturedParts and
// wherever a small grid of parts is shown. The store agent may restyle it.
import { Image } from 'astro:assets';
import { partUrl, type Part } from '../lib/parts';

interface Props {
  part: Part;
  eager?: boolean;
}

const { part, eager = false } = Astro.props;
const { data } = part;
const photo = data.images[0];
---

<a class="part-card" href={partUrl(part)}>
  <span class="part-card__media">
    {photo ? (
      <Image src={photo} alt={data.imageAlt} widths={[160, 250]} sizes="(min-width: 900px) 200px, 45vw" loading={eager ? 'eager' : 'lazy'} />
    ) : (
      <span class="part-card__nophoto">Photo coming soon</span>
    )}
  </span>
  <span class="part-card__body">
    <span class="part-card__name">{data.name}</span>
    <span class="part-card__oem">Hayssen # {data.oem}</span>
    <span class="part-card__cm">{data.cm}</span>
  </span>
</a>

<style>
  .part-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
  }

  .part-card:hover {
    box-shadow: var(--shadow);
  }

  .part-card__media {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 4;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
  }

  .part-card__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .part-card__nophoto {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .part-card__body {
    display: grid;
    gap: 2px;
    padding: 12px 14px 14px;
  }

  .part-card__name {
    font-weight: 700;
    line-height: 1.25;
  }

  .part-card__oem {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.95rem;
    color: var(--color-primary);
  }

  .part-card__cm {
    font-size: 0.875rem;
    color: var(--color-muted);
  }
</style>
