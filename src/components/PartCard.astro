---
// Part card (photo, name and part number) for small grids such as the home
// page's featured parts. The number shown is the OEM #, or the C&M #
// for a part that has no OEM number. The photo sits in a 3:4 white box and is
// never cropped. Links to the part page, where quantity and Add live.
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import { partUrl, type Part } from '../lib/parts';
import { displayName } from '../lib/partmeta';

interface Props {
  part: Part;
  eager?: boolean;
}

const { part, eager = false } = Astro.props;
const { data } = part;
// The photo has an empty alt on purpose: the whole card is one link, and its text already gives the part's name and
// number. A description in the alt would make a screen reader read the name and number twice (the part page has it).
const photo = data.images[0];
const section = await getEntry(data.section);
---

<a class="part-card" href={partUrl(part)}>
  <span class="part-card__media">
    {
      photo ? (
        <Image
          src={photo}
          alt=""
          widths={[160, 250]}
          sizes="(min-width: 900px) 250px, 45vw"
          loading={eager ? 'eager' : 'lazy'}
        />
      ) : (
        <span class="part-card__nophoto">No photo</span>
      )
    }
  </span>
  <span class="part-card__body">
    {section && <span class="part-card__section">{section.data.title}</span>}
    <span class="part-card__name">{displayName(data)}</span>
    <span class="part-card__nums">
      <span class="part-card__label">{data.oem ? 'OEM #' : 'C&M part #'}</span>
      <span class="part-card__oem">{data.oem ?? data.cm}</span>
    </span>
    <span class="part-card__cta">View part <span aria-hidden="true">→</span></span>
  </span>
</a>

<style>
  .part-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s, transform 0.15s, border-color 0.15s;
  }

  .part-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .part-card__media {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 4;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
  }

  /* contained and capped at the file's own size: never cropped or stretched */
  .part-card__media :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .part-card__nophoto {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .part-card__body {
    display: grid;
    flex: 1;
    align-content: start;
    gap: 6px;
    padding: 14px 14px 16px;
  }

  .part-card__section {
    justify-self: start;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--color-tint);
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .part-card__name {
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .part-card__nums {
    display: grid;
    gap: 0;
  }

  .part-card__label {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .part-card__oem {
    font-family: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1rem;
    font-weight: 700;
    color: #111;
  }

  .part-card__cta {
    margin-top: 4px;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .part-card:hover .part-card__cta {
    text-decoration: underline;
  }
</style>
