---
// One part in a list: desktop table row, compact row on phones.
// Layout is CSS grid (src/styles/store.css), so the same markup serves both.
import PartAdd from './PartAdd.astro';
import { addData, thumbOf } from './store';
import { partUrl, type Part } from '../lib/parts';
import '../styles/store.css';

interface Props {
  part: Part;
  sectionTitle: string;
  eager?: boolean;
  priority?: boolean; // first rows: fetchpriority high
}

const { part, sectionTitle, eager = false, priority = false } = Astro.props;
const d = part.data;
const url = partUrl(part);
const thumb = await thumbOf(d.images[0]);
const add = await addData(part, sectionTitle);
---

<li
  class="prow"
  data-id={part.id}
  data-section={d.section.id}
  data-type={d.type}
  data-width={d.attrs.width ?? ''}
  data-side={d.attrs.side ?? ''}
  data-oem={d.oem}
  data-name={d.name}
>
  <a class="prow__thumb part-thumb" href={url} tabindex="-1" aria-hidden="true">
    {
      thumb ? (
        <img
          src={thumb.src}
          width={thumb.width}
          height={thumb.height}
          alt=""
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
        />
      ) : (
        <span class="part-thumb__none">Photo coming soon</span>
      )
    }
  </a>
  <div class="prow__main">
    <a class="prow__name" href={url}>{d.name}</a>
    <div class="prow__meta">
      <span class="chip-sec">{sectionTitle}</span>
      {d.attrs.width && <span class="chip-attr">{d.attrs.width}″</span>}
      {d.attrs.side && <span class="chip-attr">{d.attrs.side}</span>}
    </div>
  </div>
  <div class="prow__oem">
    <span class="visually-hidden">Hayssen part #</span>
    <span class="oem">{d.oem}</span>
    <button type="button" class="copybtn" data-copy={d.oem} aria-label={`Copy Hayssen part number ${d.oem}`}>
      <svg class="i-copy" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
      <svg class="i-check" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
    </button>
  </div>
  <div class="prow__cm"><span class="visually-hidden">C&M number </span>{d.cm}</div>
  <PartAdd data={add} />
</li>
