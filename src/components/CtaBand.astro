---
import { site } from '../config/site';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Ready for a quote?',
  text = `Tell us about the part or project. ${site.replyTime}.`,
} = Astro.props;
---

<section class="section section--alt cta-band">
  <div class="container">
    <h2>{heading}</h2>
    <p>{text}</p>
    <div class="cta-band__actions">
      <a class="btn" href="/quote/">Request a Quote</a>
      <a class="btn btn--outline" href={`tel:${site.phoneE164}`}>Call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    text-align: center;
  }

  .cta-band p {
    max-width: 60ch;
    margin-inline: auto;
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
