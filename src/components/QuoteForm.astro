---
// Sends to Web3Forms. With JavaScript the quote list is added to the email
// and the visitor goes to /quote/thanks/; without it the form still posts and
// Web3Forms redirects to the thank-you page. Submit logic is shared with the
// other forms in src/scripts/web3forms-submit.ts.
// A reply needs an email or a phone number, at least one. Neither input is `required` (the form must
// still post without JavaScript); the <fieldset data-reach> is checked by the shared script, which
// shows one error tied to both fields.
// The email the shop receives lists the fields in the order they are posted: who is asking and what
// they wrote first, the quote list and its reference last (added by the script below), and nothing the
// customer left empty (src/scripts/web3forms-submit.ts).
import { site } from '../config/site';
import { forms } from '../config/forms';

interface Props {
  kind: 'quote' | 'contact';
}

const { kind } = Astro.props;
const isQuote = kind === 'quote';
const thanks = new URL('/quote/thanks/', Astro.site ?? site.url).href;
// Only developers see this notice. Customers must never see a config error, so
// production builds stay silent here (WEB3FORMS_KEY in src/config/forms.ts).
const missingKey = import.meta.env.DEV && !forms.accessKey;
if (!forms.accessKey && !import.meta.env.DEV) console.warn('[forms] No Web3Forms access key: form posts will be rejected.');
---

<form
  class:list={['quote-form', `quote-form--${kind}`]}
  action={forms.endpoint}
  method="POST"
  data-quote-form
  data-kind={kind}
  data-fallback-email={site.email}
  data-reply-time={site.replyTime}
  data-shop={site.store.enabled ? undefined : 'off'}
>
  {missingKey && (
    <p class="form-alert form-alert--error" role="alert">
      Form not configured: set WEB3FORMS_KEY in src/config/forms.ts (see README).
    </p>
  )}

  <input type="hidden" name="access_key" value={forms.accessKey} />
  <input type="hidden" name="subject" value={isQuote ? `Quote request from ${site.name} website` : `Message from ${site.name} website`} />
  <input type="hidden" name="from_name" value={`${site.name} Website`} />
  <input type="hidden" name="redirect" value={thanks} />
  <!-- Honeypot: humans never see or tick this -->
  <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="field-row">
    <div class="field">
      <label for={`${kind}-name`}>{isQuote ? 'Full Name' : 'Name'} <span class="req" aria-hidden="true">*</span></label>
      <input id={`${kind}-name`} name="name" autocomplete="name" required />
    </div>
    <div class="field">
      <label for={`${kind}-company`}>Company / Organization <span class="opt">(optional)</span></label>
      <input id={`${kind}-company`} name="company" autocomplete="organization" />
    </div>
  </div>

  <fieldset class="field reach" id={`${kind}-reach`} data-reach>
    <legend>Email or phone <span class="req" aria-hidden="true">*</span></legend>
    <p class="reach__hint" id={`${kind}-reach-hint`}>Fill in at least one, so we can reply.</p>
    <div class="field-row">
      <div class="field">
        <label for={`${kind}-email`}>{isQuote ? 'Email Address' : 'Email'}</label>
        <input id={`${kind}-email`} name="email" type="email" autocomplete="email" aria-describedby={`${kind}-reach-hint`} />
      </div>
      <div class="field">
        <label for={`${kind}-phone`}>{isQuote ? 'Phone Number' : 'Phone'}</label>
        <input
          id={`${kind}-phone`}
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          placeholder="(555) 000-0000"
          aria-describedby={`${kind}-reach-hint`}
        />
      </div>
    </div>
  </fieldset>

  {isQuote && (
    <>
      <div class="field-row">
        <div class="field">
          <label for="quote-po">PO / reference # <span class="opt">(optional)</span></label>
          <input id="quote-po" name="po" autocomplete="off" />
        </div>
        <div class="field">
          <label for="quote-needed">Needed by</label>
          <select id="quote-needed" name="needed_by">
            <option value="">Select (optional)</option>
            <option>ASAP / rush</option>
            <option>This week</option>
            <option>2–4 weeks</option>
            <option>Flexible</option>
          </select>
        </div>
      </div>

      <fieldset class="field delivery">
        <legend>Delivery</legend>
        <div class="delivery__options">
          <label class="choice" for="quote-pickup">
            <input id="quote-pickup" type="radio" name="delivery" value="Pickup in Salinas" checked />
            <span>Pickup in Salinas</span>
          </label>
          <label class="choice" for="quote-ship">
            <input id="quote-ship" type="radio" name="delivery" value="Ship to me" />
            <span>Ship to me</span>
          </label>
        </div>
        <div class="field zip-field">
          <label for="quote-zip">Ship-to ZIP code</label>
          <input id="quote-zip" name="zip" inputmode="numeric" autocomplete="postal-code" maxlength="10" />
        </div>
      </fieldset>
    </>
  )}

  <div class="field">
    <label for={`${kind}-message`}>{isQuote ? 'Describe the job or notes' : 'Message'} {!isQuote && <span class="req" aria-hidden="true">*</span>}</label>
    <textarea
      id={`${kind}-message`}
      name="message"
      placeholder={isQuote
        ? 'What the part is or does, material, size, how many and when you need it. No part number? Tell us about your sample, photo or drawing.'
        : 'How can we help?'}
      required={!isQuote}></textarea>
  </div>

  {/* Red is for the page's quote action; a message is not one */}
  <button class:list={['btn btn--block quote-form__submit', { 'btn--red': isQuote }]} type="submit" data-submit>
    {isQuote ? 'Send Quote Request →' : 'Send Message →'}
  </button>
  <p class="form-alert" role="status" aria-live="polite" data-form-status></p>
  <p class="form-note">
    {site.replyTime}. Prefer to talk? Call <a href={`tel:${site.phoneE164}`}>{site.phone}</a>.
  </p>
  {/* Phones with an empty list: the drawing box of the items card (QuoteItems.astro) is not shown above
      the form there, so the same advice follows it. src/scripts/quote-page.ts fills in the reference. */}
  {isQuote && (
    <p class="form-note quote-form__drawing">
      Have a drawing or photo of the part? Email it to{' '}
      <a href={`mailto:${site.email}`} data-ref-mailto={site.email}>{site.email}</a> and put your quote reference <strong data-quote-ref></strong> in the subject.
    </p>
  )}
</form>

<script>
  import { getItems, summarize, summaryLines, countLabel, quoteRef, clearItems } from '../scripts/quote-store';
  import { bindWeb3Form, setStatus } from '../scripts/web3forms-submit';

  document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach((form) => {
    const isQuote = form.dataset.kind === 'quote';
    const status = form.querySelector<HTMLElement>('[data-form-status]');
    let ref = '';

    bindWeb3Form({
      form,
      prepare(data) {
        const name = String(data.get('name') || '').trim();
        if (!isQuote) {
          data.set('subject', `Website message from ${name}`);
          return;
        }
        const items = getItems();
        const notes = String(data.get('message') || '').trim();
        if (!items.length && !notes) {
          // With the parts shop off (data-shop="off") there is no catalog to add parts from.
          return `Describe the job or the part you need${form.dataset.shop === 'off' ? '' : ', or add parts to your list'}, so we know what to quote.`;
        }
        ref = quoteRef();
        const company = String(data.get('company') || '').trim();
        // A request with no list is a described job: no "0 items" in the subject the shop reads.
        data.set('subject', `Quote request ${ref}${items.length ? `: ${countLabel(items)}` : ''} from ${name}${company ? ` (${company})` : ''}`);
        if (data.get('delivery') !== 'Ship to me') data.delete('zip');
        // FormData keeps the order its fields were added in, and that is the order of the email:
        // the list (long) and its reference go after the contact details and the message. There are no
        // hidden inputs for them (without JavaScript there is no list to send), and a request with no
        // list sends no "products" field at all.
        data.delete('products');
        data.delete('quote_ref');
        if (items.length) data.append('products', summarize(items));
        data.append('quote_ref', ref);
      },
      fallbackBody(data) {
        const value = (name: string) => String(data.get(name) ?? '').trim();
        const head = [
          isQuote ? `Quote reference: ${value('quote_ref')}` : '',
          `Name: ${value('name')}`,
          value('email') && `Email: ${value('email')}`,
          value('phone') && `Phone: ${value('phone')}`,
          value('company') && `Company: ${value('company')}`,
          value('po') && `PO: ${value('po')}`,
          value('needed_by') && `Needed by: ${value('needed_by')}`,
          value('delivery') && `Delivery: ${value('delivery')}${value('zip') ? ` (${value('zip')})` : ''}`,
        ];
        const message = value('message');
        if (!isQuote) return [...head, message && `\n${message}`].filter(Boolean).join('\n');
        // What the customer typed comes before the list: a mailto: link is short, and when it cannot
        // hold everything it is list lines that are left out (and counted), never the message.
        const list = summaryLines().map((line, n) => `${n + 1}. ${line}`);
        return {
          text: [...head, message && `\nMessage:\n${message}`, list.length ? `\nItems (${list.length}):` : ''].filter(Boolean).join('\n'),
          list,
        };
      },
      // A quote leaves for the thank-you page, so its button stays locked after the send.
      lockOnSuccess: isQuote,
      onSuccess() {
        if (isQuote) {
          try {
            sessionStorage.setItem('last-quote-ref', ref);
          } catch {
            // the thank-you page just omits the reference
          }
          clearItems();
          location.href = '/quote/thanks/';
          return;
        }
        form.reset();
        setStatus(status, 'success', `Thanks, we got your message. ${form.dataset.replyTime ?? ''}.`);
      },
    });
  });
</script>

<style>
  .quote-form--contact {
    max-width: 720px;
  }

  .req {
    color: var(--color-accent);
  }

  .opt {
    color: var(--color-muted);
    font-weight: 400;
    font-size: 0.9em;
  }

  .delivery {
    margin: 0 0 16px;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .delivery legend {
    margin-bottom: 6px;
    padding: 0;
    font-weight: 600;
  }

  .delivery__options {
    display: grid;
    gap: 10px;
  }

  @media (min-width: 480px) {
    .delivery__options {
      grid-template-columns: 1fr 1fr;
    }
  }

  .choice {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    padding: 0 14px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    font-weight: 500;
    cursor: pointer;
  }

  .delivery .choice input {
    flex: none;
    width: 20px;
    height: 20px;
    min-height: 0;
    margin: 0;
    padding: 0;
    accent-color: var(--color-primary);
  }

  .choice:has(input:checked) {
    border-color: var(--color-primary);
    background: var(--color-tint);
  }

  .choice:has(input:focus-visible) {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Ship-to ZIP shows only when "Ship to me" is chosen (no JavaScript needed) */
  .zip-field {
    display: none;
    margin: 12px 0 0;
  }

  .delivery:has(#quote-ship:checked) .zip-field {
    display: grid;
  }

  .quote-form__submit {
    min-height: 54px;
    font-size: 1.05rem;
  }

  .form-alert {
    margin: 12px 0 0;
    padding: 12px 14px;
    border-radius: var(--radius);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .form-alert:empty {
    display: none;
  }

  .form-alert--error {
    background: #fdecea;
    border-color: #f3c4bf;
    color: var(--color-danger);
  }

  .form-alert--success {
    background: #e9f6ee;
    border-color: #b9e0c8;
    color: var(--color-success);
  }

  .form-note {
    margin: 12px 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
    text-align: center;
  }

  /* Shown only where the items card's drawing box is not: an empty list (html[data-quote], set before
     first paint by public/quote-early.js) on a single-column screen. */
  .quote-form__drawing {
    display: none;
    overflow-wrap: anywhere;
  }

  .quote-form__drawing strong {
    color: var(--color-text);
    font-family: var(--oem-font, ui-monospace, monospace);
    white-space: nowrap;
  }

  /* Room for the reference (13 characters) before the script fills it in, so the lines do not rewrap */
  :global(html[data-quote]) .quote-form__drawing strong {
    display: inline-block;
    min-width: 13ch;
  }

  @media (max-width: 899.98px) {
    :global(html:not([data-quote='filled'])) .quote-form__drawing {
      display: block;
    }
  }

  .quote-form--contact .form-note {
    text-align: left;
  }
</style>
