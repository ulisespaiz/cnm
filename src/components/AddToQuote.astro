---
// "Add to Quote" form shared by product and service pages. The id must be
// unique across both (services are prefixed with "service:").
// A service has no quantity (you do not ask for "2 of" welding), so the Quantity field is left out for a
// "service:" id and the line is added once; pass `qty` to override either way.
interface Props {
  id: string;
  title: string;
  url: string;
  options?: { name: string; values: string[] }[];
  label?: string;
  /** Show the Quantity field. Default: yes, except for a service. */
  qty?: boolean;
}

const { id, title, url, options = [], label = 'Add to Quote', qty: showQty = !id.startsWith('service:') } = Astro.props;
---

<form class="add-form" data-add-to-quote data-id={id} data-title={title} data-url={url}>
  {options.map((opt, i) => (
    <div class="field">
      <label for={`opt-${i}`}>{opt.name}</label>
      <select id={`opt-${i}`} name={opt.name} required>
        {opt.values.map((v) => <option>{v}</option>)}
      </select>
    </div>
  ))}
  {showQty && (
    <div class="field qty-field">
      <label for="qty">Quantity</label>
      <input id="qty" name="__qty" type="number" min="1" max="999" value="1" inputmode="numeric" />
    </div>
  )}
  <button class="btn btn--block" type="submit">{label}</button>
  <!-- Always in the page, empty (and so unstyled) until an add: a live region announces text put into one that was already there. -->
  <p class="add-form__status" role="status" aria-live="polite"></p>
  <noscript>
    <p><a href="/contact/">Contact us</a> to request a quote.</p>
  </noscript>
</form>

<script>
  import { addItem, lineCount } from '../scripts/quote-store';

  document.querySelectorAll<HTMLFormElement>('[data-add-to-quote]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const qty = Number(data.get('__qty')) || 1; // no field (a service): one
      data.delete('__qty');
      const options = Object.fromEntries([...data.entries()].map(([k, v]) => [k, String(v)]));
      addItem({
        id: form.dataset.id!,
        title: form.dataset.title!,
        url: form.dataset.url!,
        options,
        qty: Math.max(1, Math.min(999, Math.round(qty))),
      });
      // New nodes each time, so a second add of the same service is announced again.
      const link = document.createElement('a');
      link.href = '/quote/';
      link.textContent = `View your quote (${lineCount()})`;
      form.querySelector<HTMLElement>('.add-form__status')!.replaceChildren('Added. ', link);
    });
  });
</script>

<style>
  .qty-field input {
    max-width: 120px;
  }

  .add-form__status {
    margin-top: 12px;
    padding: 12px 14px;
    border-radius: var(--radius);
    background: #e8f5ec;
    color: var(--color-success);
    font-weight: 600;
  }

  .add-form__status:empty {
    margin: 0;
    padding: 0;
  }
</style>
