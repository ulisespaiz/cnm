---
// "Items in Your Request" card: the live quote list (rendered by
// src/scripts/quote-page.ts), the reference, summary, drawing box and the
// bulk paste panel. With the parts shop off (site.store.enabled) there is no
// catalog to match against, so the empty state points to the services instead
// and the bulk paste panel is left out. A returning visitor's list is flagged
// before first paint by public/quote-early.js (html[data-quote="filled"]).
//
// An empty list is one short note, not a step to complete: most visitors who want a job or a part
// quoted have no list, and the form is all they need. Where the form sits under this card (one
// column, under 900px) the empty card is only that note, so the form starts on the first screen:
// the header, the reassurances, the drawing box (QuoteForm.astro repeats it after the form) and the
// closed bulk paste panel are left out there. All of it is CSS on html[data-quote], which is known
// before first paint, so nothing moves once the page is drawn.
import { site } from '../config/site';
import QuoteSummary from './QuoteSummary.astro';
import BulkPaste from './BulkPaste.astro';

const shopOn = site.store.enabled;
---

<section class="qcard qcard--items" aria-labelledby="items-title">
  <header class="qcard__head">
    <h2 id="items-title" class="qcard__title qcard__title--red" tabindex="-1">{shopOn ? 'Items in Your Request' : 'Your Request'}</h2>
    <p class="qref">Reference <strong data-quote-ref>Q-</strong></p>
    {/* One column, list filled: the form is under the whole list, however long it is */}
    <a class="qskip" href="#details">Skip to your details <span aria-hidden="true">↓</span></a>
  </header>

  <div class="qcard__body">
    <div class="qempty" data-quote-empty>
      {/* Takes focus when the last line is removed, so it says what just happened to a screen reader */}
      <p class="qempty__text" tabindex="-1" data-quote-empty-title>
        <span class="visually-hidden">Your quote list is empty. </span>
        {shopOn ? (
          <><strong>No parts list needed.</strong> A part number, a sample or a print is enough: just fill in the form.</>
        ) : (
          <>A part number, a sample or a print is enough: just fill in the form and tell us what you need.</>
        )}
      </p>
      <p class="qempty__links">
        {shopOn && <a href="/shop/">Browse parts</a>}
        {shopOn && <a href="#bulk">Paste a list</a>}
        <a href="/services/">Our services</a>
      </p>
    </div>

    <div data-quote-filled hidden>
      <ul class="qi-list" data-quote-items></ul>
      <button type="button" class="qclear" data-clear-all>Clear all items</button>
      <!-- Phones stack the form under the list, past the summary and the drawing box: a way straight to it -->
      <a class="btn btn--block qcontinue" href="#details">Continue: your details</a>
    </div>

    <QuoteSummary />

    <div class="qdrop">
      <h3>Have a drawing or photo of the part?</h3>
      <p>
        Email it to <a href={`mailto:${site.email}`} data-ref-mailto={site.email}>{site.email}</a> and put your quote reference{' '}<strong data-quote-ref>above</strong> in the subject. We'll attach it to your quote.
      </p>
    </div>

    {shopOn && <BulkPaste />}
  </div>
</section>

<style>
  .qcard {
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .qcard__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 12px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--color-border);
  }

  .qcard__title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  .qcard__title::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--color-accent);
  }

  .qref {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .qref strong {
    /* Reserve the width of the real reference (Q-YYMMDD-XXXX, 13 monospace characters)
       so filling it in from quote-page.ts does not wrap the header and push the card down. */
    display: inline-block;
    min-width: 13.5ch;
    padding: 3px 8px;
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--oem-font, ui-monospace, monospace);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .qcard__body {
    padding: 8px 20px 20px;
  }

  .qempty {
    padding: 14px 0 0;
  }

  .qempty[hidden],
  [data-quote-filled][hidden] {
    display: none;
  }

  /* Returning visitor with items: quote-early.js sets html[data-quote="filled"] before first paint, so the
     empty state is never drawn and the filled blocks (here and in QuoteSummary) are there from the start.
     quote-page.ts takes over when it runs. Without the script nothing here applies: the empty state shows. */
  :global(html[data-quote='filled'] .qempty) {
    display: none;
  }

  :global(html[data-quote='filled'] [data-quote-filled][hidden]) {
    display: block;
  }

  .qempty__text {
    margin: 0;
  }

  /* Small secondary links, each a 44px tap target */
  .qempty__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    margin: 2px 0 0;
    font-size: 0.95rem;
  }

  .qempty__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  .qskip {
    display: none;
  }

  @media (max-width: 899.98px) {
    :global(html[data-quote='filled']) .qskip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 44px;
      margin-bottom: -12px; /* the header's own padding is under it */
      font-weight: 600;
      font-size: 0.95rem;
    }

    /* Empty list, one column: only the note (see the top of this file). The bulk paste panel comes back
       when "Paste a list" opens it, or when the address ends in #bulk. */
    :global(html:not([data-quote='filled']) .qcard--items > .qcard__head),
    :global(html:not([data-quote='filled']) .qcard--items .qdrop),
    :global(html:not([data-quote='filled']) .qcard--items #bulk:not([open]):not(:target)) {
      display: none;
    }

    :global(html:not([data-quote='filled']) .qcard--items > .qcard__body) {
      padding: 0 16px 4px;
    }
  }

  .qi-list {
    margin: 0;
    padding: 0;
    list-style: none;
    /* Room for the rows until quote-page.ts draws them (it removes --quote-rows, which quote-early.js
       set to the number of saved lines, 6 at most): about one row each, so the form below stays put.
       --qi-row is a typical catalog row (stacked on phones, three columns from 480px). */
    --qi-row: 200px;
    min-height: calc(var(--quote-rows, 0) * var(--qi-row));
  }

  @media (min-width: 480px) {
    .qi-list {
      --qi-row: 143px;
    }
  }

  @media (min-width: 900px) {
    .qi-list {
      --qi-row: 150px;
    }
  }

  /* Rows are created by quote-page.ts, hence :global under the list. */
  .qi-list :global(.qi) {
    display: grid;
    grid-template-columns: 56px 1fr;
    grid-template-areas: 'thumb main' 'controls controls';
    gap: 10px 12px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .qi-list :global(.qi__thumb) {
    grid-area: thumb;
    display: grid;
    place-items: center;
    width: 56px;
    height: 75px;
    outline: 1px solid var(--color-border);
    outline-offset: -1px;
    border-radius: 8px;
    background: #fff;
    overflow: hidden;
    color: var(--color-muted);
  }

  .qi-list :global(.qi__thumb img) {
    width: 56px;
    height: 75px;
    object-fit: contain;
  }

  .qi-list :global(.qi__ph) {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--color-bg);
  }

  .qi-list :global(.qi__main) {
    grid-area: main;
    min-width: 0;
  }

  .qi-list :global(.qi__name) {
    display: flex;
    align-items: center;
    min-height: 44px; /* tap target: the name is the only link to the part page */
    color: var(--color-text);
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .qi-list :global(a.qi__name:hover) {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .qi-list :global(.qi__meta) {
    margin: 2px 0 0;
    color: var(--color-muted);
    font-size: 0.88rem;
    line-height: 1.4;
    overflow-wrap: break-word;
  }

  .qi-list :global(.qi__code) {
    white-space: nowrap;
  }

  .qi-list :global(.qi__meta[hidden]) {
    display: none;
  }

  .qi-list :global(.qi__link) {
    min-height: 44px;
    padding: 0 2px;
    border: 0;
    background: none;
    color: var(--color-primary);
    font: 600 0.9rem/1 var(--font-body);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .qi-list :global(.qi__link[hidden]) {
    display: none;
  }

  .qi-list :global(.qi__remove) {
    color: var(--color-danger);
    padding: 0 8px;
  }

  /* The note is the last child of the row and spans all its columns, so a phone gives it the full width. */
  .qi-list :global(.qi__note) {
    grid-column: 1 / -1;
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid var(--color-field-border);
    border-radius: 10px;
    background: #fff;
    font: 400 1rem/1.4 var(--font-body);
    resize: vertical;
  }

  .qi-list :global(.qi__note[hidden]) {
    display: none;
  }

  .qi-list :global(.qi__controls) {
    grid-area: controls;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  /* A service line has no quantity: its only control stays on the right */
  .qi-list :global(.qi--service .qi__controls) {
    justify-content: flex-end;
  }

  .qi-list :global(.qi__stepper) {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-field-border);
    border-radius: 10px;
    background: #fff;
    overflow: hidden;
  }

  .qi-list :global(.qi__stepper:focus-within) {
    border-color: var(--color-accent);
  }

  /* The stepper clips what is outside it: draw the focus ring inside the buttons */
  .qi-list :global(.qi__step:focus-visible),
  .qi-list :global(.qi__qty:focus-visible) {
    outline-offset: -3px;
  }

  .qi-list :global(.qi__step) {
    width: 44px;
    height: 44px;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font: 600 1.25rem/1 var(--font-body);
    cursor: pointer;
  }

  .qi-list :global(.qi__step:hover) {
    background: #e9e9e9;
  }

  .qi-list :global(.qi__qty) {
    width: 56px;
    height: 44px;
    border: 0;
    border-inline: 1px solid var(--color-border);
    background: #fff;
    font: 600 1rem/1 var(--font-body);
    text-align: center;
    -moz-appearance: textfield;
    appearance: textfield;
  }

  .qi-list :global(.qi__qty::-webkit-outer-spin-button),
  .qi-list :global(.qi__qty::-webkit-inner-spin-button) {
    -webkit-appearance: none;
    margin: 0;
  }

  @media (min-width: 480px) {
    .qi-list :global(.qi) {
      grid-template-columns: 56px 1fr auto;
      grid-template-areas: 'thumb main controls';
      align-items: start;
    }

    .qi-list :global(.qi__controls) {
      flex-direction: column;
      align-items: flex-end;
      gap: 4px;
    }
  }

  .qcontinue {
    margin-top: 12px;
  }

  @media (min-width: 900px) {
    /* Two columns from here: the form is beside the list, not far below it */
    .qcontinue {
      display: none;
    }
  }

  .qclear {
    min-height: 44px;
    margin-top: 4px;
    padding: 0 2px;
    border: 0;
    background: none;
    color: var(--color-muted);
    font: 600 0.9rem/1 var(--font-body);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .qdrop {
    margin-top: 20px;
    padding: 16px;
    border: 2px dashed #c8c8c8;
    border-radius: var(--radius);
    background: #fafafa;
  }

  .qdrop h3 {
    margin-bottom: 6px;
    font-size: 1rem;
  }

  .qdrop p {
    margin: 0;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }

  .qdrop strong {
    font-family: var(--oem-font, ui-monospace, monospace);
    white-space: nowrap;
  }

  /* quote-page.ts puts the reference (13 characters) where the word "above" is. With JavaScript, which
     html[data-quote] shows, its room is kept from the start, so the sentence does not rewrap and push
     the form down under a visitor who came in at #details. */
  :global(html[data-quote]) .qdrop strong {
    display: inline-block;
    min-width: 13ch;
  }
</style>
