---
// Collapsible "Paste a list of part numbers" panel. Opens automatically when
// the URL hash is #bulk. Behaviour lives in src/scripts/quote-page.ts, the
// parser in src/scripts/bulk-parse.ts.
---

<details class="bulk" id="bulk">
  <summary>
    <span>Paste a list of part numbers</span>
    <svg class="bulk__chev" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 4.5l4 4 4-4" /></svg>
  </summary>
  <div class="bulk__body">
    <label class="bulk__label" for="bulk-text">One part per line, with an optional quantity</label>
    <textarea id="bulk-text" data-bulk-text rows="6" spellcheck="false" autocapitalize="characters" placeholder={'03187A0897 x2\n3186-D0379, 3\n2 x CM-0002'}></textarea>
    <p class="bulk__help muted">
      Hayssen part numbers (spaces and dashes are fine) or C&amp;M numbers. Quantity can come before or after,
      like <code>x2</code>, <code>2 pcs</code> or a number from a spreadsheet column. Up to 200 lines.
    </p>
    <button type="button" class="btn btn--outline" data-bulk-check>Check list</button>
    <p class="bulk__error" role="alert" data-bulk-message hidden></p>

    <div class="bk" data-bulk-preview hidden>
      <p class="bk__summary" data-bulk-summary aria-live="polite"></p>
      <ul class="bk__rows" data-bulk-rows></ul>
      <button type="button" class="btn btn--red btn--block" data-bulk-add>Add lines to quote</button>
    </div>
  </div>
</details>

<style>
  .bulk {
    margin-top: 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
  }

  .bulk summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: var(--tap);
    padding: 0 16px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .bulk summary::-webkit-details-marker {
    display: none;
  }

  .bulk__chev {
    flex: none;
    transition: transform 0.15s;
  }

  .bulk[open] .bulk__chev {
    transform: rotate(180deg);
  }

  .bulk__body {
    padding: 4px 16px 16px;
  }

  .bulk__label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .bulk textarea {
    width: 100%;
    min-height: 140px;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    font: 400 1rem/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    resize: vertical;
  }

  .bulk__help {
    margin: 8px 0 12px;
    font-size: 0.9rem;
  }

  .bulk__help code {
    padding: 1px 5px;
    border-radius: 4px;
    background: var(--color-bg);
    font-size: 0.85em;
  }

  .bulk__error {
    margin: 12px 0 0;
    padding: 10px 12px;
    border-radius: var(--radius);
    background: #fdecea;
    color: var(--color-danger);
    font-size: 0.95rem;
  }

  .bulk__error[hidden],
  .bk[hidden] {
    display: none;
  }

  .bk {
    margin-top: 16px;
  }

  .bk__summary {
    margin: 0 0 8px;
    font-weight: 600;
  }

  .bk__rows {
    display: grid;
    gap: 8px;
    margin: 0 0 14px;
    padding: 0;
    list-style: none;
  }

  /* Rows are built by quote-page.ts, so these selectors are global-in-scope. */
  .bk__rows :global(.bk__row) {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    grid-template-areas: 'img what qty' 'img state qty';
    align-items: center;
    column-gap: 10px;
    row-gap: 2px;
    padding: 8px 10px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: #fff;
  }

  .bk__rows :global(.bk__row--ok) {
    border-left: 4px solid var(--color-success);
  }

  .bk__rows :global(.bk__row--miss) {
    border-left: 4px solid var(--color-accent);
    background: #fff8f8;
  }

  .bk__rows :global(.bk__row > img),
  .bk__rows :global(.bk__ph) {
    grid-area: img;
    width: 36px;
    height: 48px;
    object-fit: contain;
    border-radius: 6px;
    background: var(--color-bg);
  }

  .bk__rows :global(.bk__what) {
    grid-area: what;
    display: grid;
    min-width: 0;
    font-size: 0.9rem;
    line-height: 1.3;
  }

  .bk__rows :global(.bk__what strong) {
    overflow-wrap: anywhere;
  }

  .bk__rows :global(.bk__what span) {
    color: var(--color-muted);
  }

  .bk__rows :global(.bk__dup) {
    font-size: 0.8rem;
  }

  .bk__rows :global(.bk__state),
  .bk__rows :global(.bk__anyway) {
    grid-area: state;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 0.9rem;
  }

  .bk__rows :global(.bk__state) {
    min-height: 0;
    color: var(--color-success);
    font-weight: 600;
  }

  .bk__rows :global(.bk__anyway input) {
    width: 22px;
    height: 22px;
    accent-color: var(--color-accent);
  }

  .bk__rows :global(.bk__qty) {
    grid-area: qty;
    width: 64px;
    min-height: 44px;
    padding: 0 8px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    font: inherit;
    text-align: center;
  }
</style>
