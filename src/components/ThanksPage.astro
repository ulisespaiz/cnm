---
// The thank-you page layout shared by /quote/thanks/ and /contact/thanks/: a heading and lead, then two cards
// ("What happens next" and "Need anything else?"). Both pages are noindex, have no bottom bar on phones and
// are left out of the sitemap (astro.config.mjs). Slots: `lead` (inside the lead paragraph), `next` (the card
// body) and `more` (the links, one button each).
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading } = Astro.props;
---

<Base title={title} description={description} noindex hideMobileBar>
  <section class="section thanks">
    <div class="container">
      <p class="eyebrow">C&amp;M MACHINE SHOP</p>
      <h1>{heading}</h1>
      <p class="lead"><slot name="lead" /></p>

      <div class="thanks__grid">
        <section class="tcard" aria-labelledby="next-title">
          <h2 id="next-title" class="tcard__title">What happens next</h2>
          <slot name="next" />
        </section>

        <section class="tcard" aria-labelledby="more-title">
          <h2 id="more-title" class="tcard__title">Need anything else?</h2>
          <div class="thanks__links">
            <slot name="more" />
          </div>
        </section>
      </div>
    </div>
  </section>
</Base>

<style>
  .thanks h1 {
    font-size: clamp(2rem, 5vw + 0.5rem, 3.25rem);
  }

  .thanks .eyebrow {
    margin-bottom: 14px;
    padding-inline: 0;
    background: transparent;
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }

  .thanks__grid {
    display: grid;
    gap: 20px;
    margin-top: 24px;
  }

  @media (min-width: 800px) {
    .thanks__grid {
      grid-template-columns: 1.3fr 1fr;
      align-items: start;
    }
  }

  .tcard {
    padding: 22px 20px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow);
  }

  .tcard__title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 14px;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  .tcard__title::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--color-accent);
  }

  /* The steps and the reference box are written by the pages, so they are styled with :global */
  .tcard :global(.steps) {
    display: grid;
    gap: 10px;
    margin: 0 0 16px;
    padding-left: 22px;
  }

  .tcard :global(.steps:last-child) {
    margin-bottom: 0;
  }

  .tcard :global(.thanks__ref) {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 14px;
    border: 2px dashed #c8c8c8;
    border-radius: var(--radius);
    background: #fafafa;
  }

  .tcard :global(.thanks__ref[hidden]) {
    display: none;
  }

  .tcard :global(.thanks__ref strong) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 1.15rem;
    letter-spacing: 0.03em;
  }

  .tcard :global(.thanks__ref .muted) {
    font-size: 0.9rem;
  }

  .thanks__links {
    display: grid;
    gap: 10px;
  }
</style>
