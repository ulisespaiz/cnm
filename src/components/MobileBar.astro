---
import { site } from '../config/site';
---

<nav class="mobile-bar" aria-label="Quick actions">
  <a class="mobile-bar__call" href={`tel:${site.phoneE164}`}>
    <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"
      ><path
        fill="currentColor"
        d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"
      ></path></svg
    >
    Call
  </a>
  <!-- quote-store's renderCount() flips data-quote-has-items and fills the count. -->
  <a class="mobile-bar__quote" href="/quote/" data-quote-has-items="false">
    <span class="mb-empty">Get a Quote</span>
    <span class="mb-full">Review quote (<span data-quote-count hidden>0</span>)</span>
  </a>
</nav>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 8px;
    padding: 8px var(--gutter) calc(8px + env(safe-area-inset-bottom));
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
    box-shadow: 0 -2px 12px rgb(0 0 0 / 0.08);
  }

  .mobile-bar a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: var(--tap);
    border-radius: var(--radius);
    font-weight: 700;
    text-decoration: none;
  }

  .mobile-bar__call {
    border: 2px solid var(--color-primary);
    background: #fff;
    color: var(--color-primary);
  }

  .mobile-bar__quote {
    background: var(--color-accent);
    color: #fff;
  }

  .mobile-bar__quote[data-quote-has-items='true'] .mb-empty,
  .mobile-bar__quote[data-quote-has-items='false'] .mb-full {
    display: none;
  }

  @media (min-width: 768px) {
    .mobile-bar {
      display: none;
    }
  }
</style>
