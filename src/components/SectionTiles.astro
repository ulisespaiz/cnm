---
// Section tiles: a representative photo, the section name and its part count.
// variant "cards" adds the section blurb (machine hub).
import { thumbOf } from './store';
import { sectionUrl, type Part, type Section } from '../lib/parts';
import '../styles/store.css';

interface Props {
  sections: Section[];
  parts: Part[];
  variant?: 'tiles' | 'cards';
}

const { sections, parts, variant = 'tiles' } = Astro.props;

const tiles = await Promise.all(
  sections.map(async (s) => {
    const mine = parts.filter((p) => p.data.section.id === s.id);
    const rep = mine.find((p) => p.data.featured && p.data.images[0]) ?? mine.find((p) => p.data.images[0]);
    return { s, n: mine.length, thumb: await thumbOf(rep?.data.images[0]) };
  }),
);
---

<ul class={`stiles stiles--${variant}`}>
  {
    tiles.map(({ s, n, thumb }) => (
      <li>
        <a class="stile" href={sectionUrl(s)}>
          <span class="stile__thumb part-thumb">
            {thumb && <img src={thumb.src} width={thumb.width} height={thumb.height} alt="" loading="lazy" decoding="async" />}
          </span>
          <span class="stile__text">
            <span class="stile__title">{s.data.title}</span>
            <span class="stile__n">{n} {n === 1 ? 'part' : 'parts'}</span>
            {variant === 'cards' && <span class="stile__blurb">{s.data.blurb}</span>}
          </span>
          <svg class="stile__arrow" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"></path></svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .stiles {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stile {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 100%;
    min-height: 84px;
    padding: 10px 12px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.15s, border-color 0.15s;
  }

  .stile:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow);
  }

  .stile__thumb {
    flex: none;
    width: 48px;
  }

  .stile__text {
    display: grid;
    min-width: 0;
    gap: 2px;
    line-height: 1.25;
  }

  .stile__title {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .stile__n {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .stile__blurb {
    display: none;
  }

  .stile__arrow {
    display: none;
    flex: none;
    margin-left: auto;
    color: var(--color-primary);
  }

  @media (min-width: 640px) {
    .stiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .stiles--tiles {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 12px;
    }

    .stiles--tiles .stile {
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 10px;
      padding: 14px;
    }

    .stiles--tiles .stile__thumb {
      width: 64px;
    }
  }

  /* machine hub: roomier cards with the section blurb */
  .stiles--cards {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .stiles--cards .stile {
    align-items: flex-start;
    gap: 16px;
    padding: 16px;
  }

  .stiles--cards .stile__thumb {
    width: 72px;
  }

  .stiles--cards .stile__title {
    font-size: 1.2rem;
  }

  .stiles--cards .stile__blurb {
    display: block;
    margin-top: 4px;
    color: #444;
    font-size: 0.95rem;
  }

  .stiles--cards .stile__arrow {
    display: block;
    align-self: center;
  }

  @media (min-width: 768px) {
    .stiles--cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
