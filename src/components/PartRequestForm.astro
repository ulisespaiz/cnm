---
// "Can't find your part?" request form (Web3Forms). Usable with no props.
// `compact` stacks the fields and tucks the optional ones away, for part pages
// and the search "no results" state. Prefilled by the "part-request:prefill"
// document event ({ detail: { query } }) and by ?part= in the URL.
// With the parts shop off (site.store.enabled) the copy drops the catalog and
// Hayssen wording: it is a plain "send us the part number" form.
import { site } from '../config/site';
import { forms } from '../config/forms';

interface Props {
  compact?: boolean;
  /** Prefill from ?part= in the URL (the quote page turns this off). */
  urlPrefill?: boolean;
  /** Visible heading; the id stays "request" so #request links work. */
  heading?: string;
}

const shopOn = site.store.enabled;
const { compact = false, urlPrefill = true, heading = shopOn ? "Can't find your part?" : 'Replacement part request' } = Astro.props;
const thanks = new URL('/quote/thanks/', Astro.site ?? site.url).href;
const Heading = compact ? 'h3' : 'h2';
---

<section class:list={['part-request', { 'part-request--compact': compact }]} id="request" data-part-request-box>
  <Heading class="part-request__title">{heading}</Heading>
  <p class="pr__lead">{shopOn ? <>Send us the Hayssen part number and we'll check it.</> : <>Send us the part number and we'll check it and quote it.</>} {site.replyTime}.</p>

  <form
    class="pr__form"
    action={forms.endpoint}
    method="POST"
    data-part-request
    data-url-prefill={String(urlPrefill)}
    data-fallback-email={site.email}
    data-reply-time={site.replyTime}
  >
    <input type="hidden" name="access_key" value={forms.accessKey} />
    <input type="hidden" name="subject" value={`Part request from ${site.name} website`} />
    <input type="hidden" name="from_name" value={`${site.name} Website`} />
    <input type="hidden" name="redirect" value={thanks} />
    <input type="hidden" name="searched_for" value="" />
    <input type="hidden" name="page" value="" />
    <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="field-row">
      <div class="field">
        <label for="pr-number">{shopOn ? 'Hayssen part number' : 'Part number'}</label>
        <input id="pr-number" name="part_number" autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder={shopOn ? 'e.g. 03186D0379' : 'The number stamped on the part'} />
      </div>
      <div class="field pr__qty">
        <label for="pr-qty">Qty</label>
        <input id="pr-qty" name="qty" type="number" min="1" max="999" value="1" inputmode="numeric" />
      </div>
    </div>

    {
      compact ? (
        <details class="pr__more">
          <summary>Add a description or machine model</summary>
          <div class="field">
            <label for="pr-description">What does it do?</label>
            <textarea id="pr-description" name="description" rows="3"></textarea>
          </div>
          <div class="field">
            <label for="pr-machine">Machine model / serial</label>
            <input id="pr-machine" name="machine" autocomplete="off" />
          </div>
        </details>
      ) : (
        <>
          <div class="field">
            <label for="pr-description">What does it do? <span class="opt">(optional)</span></label>
            <textarea id="pr-description" name="description" rows="3" placeholder="Part name, where it sits on the machine, or anything stamped on it"></textarea>
          </div>
          <div class="field">
            <label for="pr-machine">Machine model / serial <span class="opt">(optional)</span></label>
            <input id="pr-machine" name="machine" autocomplete="off" />
          </div>
        </>
      )
    }

    <div class="field-row">
      <div class="field">
        <label for="pr-name">Name <span class="req" aria-hidden="true">*</span></label>
        <input id="pr-name" name="name" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="pr-contact">Phone or email <span class="req" aria-hidden="true">*</span></label>
        <input id="pr-contact" name="contact" autocomplete="email" inputmode="email" autocapitalize="none" required />
      </div>
    </div>

    <button class="btn btn--block" type="submit" data-submit>Send part request →</button>
    <p class="pr__status" role="status" aria-live="polite" data-form-status></p>
  </form>

  <div class="pr__ok" data-pr-success tabindex="-1" hidden>
    <h3>Request sent</h3>
    <p data-pr-message></p>
  </div>

  <p class="pr__call">
    Prefer to talk? <a class="pr__tel" href={`tel:${site.phoneE164}`}>Call {site.phone}</a>
  </p>
</section>

<script>
  import '../scripts/part-request';
</script>

<style>
  .part-request {
    padding: 24px;
    border: 1px solid var(--color-border);
    border-radius: 16px;
    background: #fff;
    scroll-margin-top: 140px;
  }

  .part-request--compact {
    padding: 18px;
  }

  .part-request__title {
    margin-bottom: 6px;
    font-size: clamp(1.4rem, 2.5vw + 0.6rem, 1.9rem);
  }

  .part-request--compact .part-request__title {
    font-size: 1.2rem;
  }

  .pr__lead {
    margin-bottom: 16px;
    color: var(--color-muted);
  }

  .req {
    color: var(--color-accent);
  }

  .opt {
    color: var(--color-muted);
    font-weight: 400;
    font-size: 0.9em;
  }

  .pr__qty input {
    max-width: 120px;
  }

  .part-request--compact .field-row {
    grid-template-columns: 1fr;
  }

  .pr__more {
    margin-bottom: 16px;
  }

  .pr__more summary {
    display: flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 8px;
    color: var(--color-primary);
    font-weight: 600;
    cursor: pointer;
  }

  .pr__status {
    margin: 12px 0 0;
    padding: 12px 14px;
    border-radius: var(--radius);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .pr__status:empty {
    display: none;
  }

  .pr__status.form-alert--error {
    background: #fdecea;
    border-color: #f3c4bf;
    color: var(--color-danger);
  }

  .pr__status.form-alert--success {
    background: #e9f6ee;
    color: var(--color-success);
  }

  .pr__form[hidden],
  .pr__ok[hidden] {
    display: none;
  }

  .pr__ok {
    padding: 16px;
    border-radius: var(--radius);
    background: #e9f6ee;
    border: 1px solid #b9e0c8;
  }

  .pr__ok h3 {
    margin-bottom: 4px;
    color: var(--color-success);
  }

  .pr__ok p {
    margin: 0;
  }

  .pr__call {
    margin: 14px 0 0;
    color: var(--color-muted);
  }

  .pr__tel {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }
</style>
