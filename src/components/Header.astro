---
import { Picture } from 'astro:assets';
import logo from '../assets/site/cnm-logo.png';
import { site, nav } from '../config/site';

const shopOn = site.store.enabled;
const path = Astro.url.pathname;
const links = [{ label: 'Home', href: '/' }, ...nav];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <Picture src={logo} alt={`${site.name} logo`} height={56} densities={[1, 2]} formats={['avif', 'webp']} quality={80} loading="eager" />
    </a>

    <nav class="nav-desktop" aria-label="Main">
      {links.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="header-phone" href={`tel:${site.phoneE164}`}>{site.phone}</a>

      <!-- Quote: "Get a Quote" while the list is empty, "Quote list" with the count once it has items.
           quote-store's renderCount() sets data-quote-has-items; until it runs (it is a module, so it can run
           after the first paint) public/quote-early.js, loaded in Base.astro's <head>, has already set
           html[data-quote] from the saved list, so the right word is painted first. Both words share one
           grid cell, so the button keeps its width when the state flips. The visible word names the link.
           Under 768px the bottom bar carries the quote link and its count, so this button is hidden there. -->
      <a class="btn btn--red cart-btn" href="/quote/" data-quote-has-items="">
        <svg class="cart-btn__icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect>
          <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
          <path d="M12 11h4"></path><path d="M12 16h4"></path><path d="M8 11h.01"></path><path d="M8 16h.01"></path>
        </svg>
        <span class="qlabel"><span class="qlabel__empty">Get a Quote</span><span class="qlabel__full">Quote list</span></span>
        <span class="badge" data-quote-count hidden>0</span>
      </a>
      <!-- Parts, phones and tablets: a quiet outline button with its word. From 1100px the nav link is enough. -->
      {shopOn && (
        <a class="btn btn--outline shop-btn" href="/shop/">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7"></path>
            <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
            <path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4"></path>
            <path d="M2 7h20"></path>
            <path d="M22 7v3a2 2 0 0 1-2 2a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 16 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 12 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 8 12a2.7 2.7 0 0 1-1.59-.63.7.7 0 0 0-.82 0A2.7 2.7 0 0 1 4 12a2 2 0 0 1-2-2V7"></path>
          </svg>
          Parts
        </a>
      )}
    </div>

    <button class="burger-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu" data-menu-toggle>
      <span class="burger" aria-hidden="true"></span>
    </button>
  </div>

  <nav class="nav-mobile" id="mobile-menu" aria-label="Main mobile" hidden data-menu>
    {links.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <a class="menu-quote" href="/quote/" data-quote-has-items="">
      <span class="qlabel__empty">Get a Quote</span>
      <span class="qlabel__full">Quote list (<span data-quote-count hidden>0</span>)</span>
    </a>
    <a href={`tel:${site.phoneE164}`}>Call {site.phone}</a>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    const isOpen = () => !menu.hidden;

    toggle.addEventListener('click', () => setOpen(!isOpen()));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    // Tabbing past the last link ("Call ...") must not leave the panel open over the page.
    menu.addEventListener('focusout', (e) => {
      const n = e.relatedTarget as Node | null;
      if (n && !menu.contains(n) && n !== toggle) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !menu.contains(e.target as Node) && !toggle.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    // Nav links show inline from 1100px, so drop the panel if the window grows past it.
    window.matchMedia('(min-width: 1100px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 72px;
  }

  .brand {
    display: flex;
    flex: none;
    margin-right: auto;
  }

  .brand img {
    width: auto;
    height: 48px;
  }

  .nav-desktop {
    display: none;
  }

  .nav-desktop a,
  .nav-mobile a {
    color: var(--color-text);
    text-decoration: none;
    font-weight: 600;
  }

  .nav-desktop a:hover,
  .nav-mobile a:hover {
    color: var(--color-primary);
  }

  [aria-current='page'] {
    color: var(--color-primary) !important;
  }

  /* Quote and Parts buttons. Phones: only Parts (the bottom bar has the quote link). 768px up: both.
     1100px up: only the quote button (Parts is in the nav). */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header-phone {
    display: none;
  }

  .shop-btn {
    padding: 0 14px;
  }

  .shop-btn svg {
    width: 18px;
    height: 18px;
  }

  .cart-btn {
    display: none;
    position: relative;
  }

  /* Both words in one grid cell: the wider one sets the width, the other is hidden (and so not read). */
  .qlabel {
    display: inline-grid;
  }

  .qlabel > span {
    grid-area: 1 / 1;
  }

  .cart-btn .qlabel__full {
    visibility: hidden;
  }

  .cart-btn[data-quote-has-items='true'] .qlabel__empty,
  :global(html[data-quote='filled']) .cart-btn[data-quote-has-items=''] .qlabel__empty {
    visibility: hidden;
  }

  .cart-btn[data-quote-has-items='true'] .qlabel__full,
  :global(html[data-quote='filled']) .cart-btn[data-quote-has-items=''] .qlabel__full {
    visibility: visible;
  }

  /* The menu link: one word or the other, nothing reserved (the panel is closed at first paint). */
  .menu-quote .qlabel__full,
  .menu-quote[data-quote-has-items='true'] .qlabel__empty,
  :global(html[data-quote='filled']) .menu-quote[data-quote-has-items=''] .qlabel__empty {
    display: none;
  }

  .menu-quote[data-quote-has-items='true'] .qlabel__full,
  :global(html[data-quote='filled']) .menu-quote[data-quote-has-items=''] .qlabel__full {
    display: inline;
  }

  .badge {
    position: absolute;
    top: -6px;
    right: -6px;
    box-shadow: 0 0 0 2px #fff;
  }

  .burger-btn {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--tap);
    height: var(--tap);
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
  }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 24px;
    height: 2px;
    border-radius: 1px;
    background: var(--color-text);
    position: relative;
  }

  .burger::before,
  .burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .burger::before {
    top: -7px;
  }

  .burger::after {
    top: 7px;
  }

  .burger-btn[aria-expanded='true'] .burger {
    background: transparent;
  }

  .burger-btn[aria-expanded='true'] .burger::before {
    top: 0;
    transform: rotate(45deg);
  }

  .burger-btn[aria-expanded='true'] .burger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .nav-mobile {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    max-height: calc(100vh - 72px);
    max-height: calc(100dvh - 72px);
    overflow-y: auto;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow);
  }

  .nav-mobile[hidden] {
    display: none;
  }

  .nav-mobile a {
    display: flex;
    gap: 8px;
    align-items: center;
    min-height: 56px;
    padding: 0 var(--gutter);
    border-top: 1px solid var(--color-border);
  }

  /* Tablet: the quote button joins Parts next to the burger. */
  @media (min-width: 768px) {
    .site-header__inner {
      gap: 10px;
    }

    .header-actions .btn {
      min-height: 44px;
      padding: 0 16px;
    }

    .cart-btn {
      display: inline-flex;
    }
  }

  /* Desktop: the nav links come out of the burger. */
  @media (min-width: 1100px) {
    .burger-btn,
    .nav-mobile,
    .shop-btn {
      display: none;
    }

    .nav-desktop {
      display: flex;
      gap: 22px;
      margin-right: 16px;
    }

    .nav-desktop a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      font-size: 0.9375rem;
      font-weight: 500;
    }

    /* Mouse-driven desktop header: compact buttons (touch sizes stay below 1100px). */
    .header-actions .btn {
      min-height: 40px;
      padding: 0 14px;
      font-size: 0.9375rem;
    }

    .header-actions .btn svg {
      width: 18px;
      height: 18px;
    }
  }

  @media (min-width: 1280px) {
    .nav-desktop {
      gap: 28px;
    }
  }

  /* Short landscape screens and 400% zoom: the header scrolls away with the page (see global.css). */
  @media (max-height: 500px) {
    .site-header {
      position: static;
    }

    .nav-mobile {
      max-height: none;
    }
  }

  /* The phone number only joins the header when there is room to breathe. */
  @media (min-width: 1440px) {
    .header-phone {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      margin-right: 8px;
      color: var(--color-text);
      font-size: 0.9375rem;
      font-weight: 600;
      text-decoration: none;
      white-space: nowrap;
    }
  }
</style>
