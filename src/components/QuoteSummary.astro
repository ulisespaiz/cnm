---
// Count line, TOTAL and the two reassurances under the items list. They are plain bullets, not tick boxes:
// a blue ticked square beside a line of text reads as a checked form control. The reply time is not here:
// the page says it in its intro and under the send button.
// Filled in by src/scripts/quote-page.ts ([data-count-line]).
const checks = ['No payment required: quote only', "We'll send you a detailed quote"];
---

<div class="qs">
  <div class="qs__totals" data-quote-filled hidden>
    <p class="qs__count" data-count-line aria-live="polite"></p>
    <p class="qs__total"><span>TOTAL</span> <em>Quoted upon request</em></p>
  </div>
  <ul class="qs__checks">
    {checks.map((text) => <li>{text}</li>)}
  </ul>
</div>

<style>
  .qs__totals {
    margin-top: 8px;
    padding-top: 14px;
    border-top: 2px solid #000;
  }

  .qs__count {
    margin: 0 0 4px;
    min-height: 1.6em; /* one line: quote-page.ts fills in the text after first paint, so the lines below must not move */
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .qs__total {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-border);
    font-size: 0.9rem;
  }

  .qs__total span {
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .qs__total em {
    color: var(--color-muted);
  }

  /* Round bullets in the text colour: nothing here looks like a checkbox or a radio button */
  .qs__checks {
    display: grid;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0 0 0 20px;
    list-style: disc;
    color: #333;
    font-size: 0.95rem;
  }

  .qs__checks li::marker {
    color: var(--color-muted);
  }
</style>
