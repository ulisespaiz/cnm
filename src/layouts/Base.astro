---
import '@fontsource-variable/geist';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { localBusiness, website } from '../lib/schema';
import { getServices, serviceUrl } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  // Hide the fixed call/quote bar on phones (quote page, pages with their own bar).
  hideMobileBar?: boolean;
}

const { jsonLd = [], hideMobileBar = false, ...seo } = Astro.props;
const services = (await getServices()).map((s) => ({ name: s.data.title, url: serviceUrl(s) }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...seo} jsonLd={[localBusiness(services), website(), ...jsonLd]} />
  </head>
  <body class:list={{ 'no-mobile-bar': hideMobileBar }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {!hideMobileBar && <MobileBar />}
    <script>
      import { renderCount } from '../scripts/quote-store';
      renderCount();
    </script>
  </body>
</html>
