---
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { localBusiness, website } from '../lib/schema';
import { getServices, serviceUrl } from '../lib/content';

// The SEO props are passed straight to Seo.astro (see its Props for what each one does).
interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  twitterCard?: 'summary' | 'summary_large_image';
  ogTitle?: string;
  canonical?: boolean;
  brand?: boolean;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  // Hide the fixed call/quote bar on phones (quote page, pages with their own bar).
  hideMobileBar?: boolean;
}

const { jsonLd = [], hideMobileBar = false, ...seo } = Astro.props;
const services = (await getServices()).map((s) => ({ name: s.data.title, url: serviceUrl(s) }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preload" as="font" type="font/woff2" href={geistLatin} crossorigin />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...seo} jsonLd={[localBusiness(services), website(), ...jsonLd]} />
    <slot name="head" />
  </head>
  <body class:list={{ 'no-mobile-bar': hideMobileBar }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <!-- Live region for src/scripts/announce.ts (copy results, quantity changes). It exists before the first message, so a screen
         reader already knows it. At the top of the page, not the end: a hidden box at the end would add a pixel of scroll height. -->
    <div id="sr-status" class="visually-hidden" role="status" aria-live="polite"></div>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {!hideMobileBar && <MobileBar />}
    <!-- Live region for src/scripts/toast.ts: it must exist before the first toast, or a screen reader may miss the first message. -->
    <div id="toast-region" class="toast-region" role="status" aria-live="polite"></div>
    <script>
      import { renderCount } from '../scripts/quote-store';
      renderCount();
    </script>
  </body>
</html>
