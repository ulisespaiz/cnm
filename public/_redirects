# 301s from the old WordPress site's URLs to the new ones. Served by
# Cloudflare Workers Static Assets. Exact matches first, then splats and
# placeholders (Cloudflare evaluates static rules faster).
# Paths kept unchanged and so not listed: /, /about/, /services/, /shop/,
# /our-machinery/, /contact/
# Redirect the www host to the apex in Cloudflare (Rules > Redirect Rules);
# this file only matches paths.

# Products and categories (WooCommerce). The old products were placeholders;
# send them to the new Hayssen parts catalog.
/product/0-250-1-4-aluminum-clamp-collar/        /shop/   301
/product/1-x-1-1-4-x-1-bronze-flanged-bushing/   /shop/   301
/product/1616-gear-mitter/                       /shop/   301
/product/hayssen-vertical-form-fill-seal/        /shop/hayssen-vffs/   301
/product-category/hayssen/                       /shop/hayssen-vffs/   301
/shop/hayssen/                                   /shop/hayssen-vffs/   301

# Quote flow
/request-a-quote/   /quote/   301
/cart/              /quote/   301
/my-account/        /         301

# Earlier site generation
/machining-services/   /services/machining/           301
/machining-services    /services/machining/           301
/machining             /services/machining/           301
/machining/            /services/machining/           301
/metalwork             /services/metal-work/          301
/metalwork/            /services/metal-work/          301
/metal-fabrication     /services/custom-fabrication/  301
/metal-fabrication/    /services/custom-fabrication/  301

# WordPress leftovers
/hello-world/          /   301
/blog-post-title-5/    /   301

