# 301s from the old WordPress site's URLs to the new ones. Served by
# Cloudflare Workers Static Assets. Exact matches first, then splats and
# placeholders (Cloudflare evaluates static rules faster).
# Paths kept unchanged and so not listed: /, /about/, /services/, /shop/,
# /our-machinery/, /contact/
# Redirect the www host to the apex in Cloudflare (Rules > Redirect Rules);
# this file only matches paths.

# Products and categories (WooCommerce). The old products were placeholders;
# send them to the VFFS parts catalog.
/product/0-250-1-4-aluminum-clamp-collar/        /shop/   301
/product/1-x-1-1-4-x-1-bronze-flanged-bushing/   /shop/   301
/product/1616-gear-mitter/                       /shop/   301
/product/hayssen-vertical-form-fill-seal/        /shop/vffs/   301
/product/hayssen-vertical-form-fill-seal         /shop/vffs/   301
/product-category/hayssen/                       /shop/vffs/   301
/product-category/hayssen                        /shop/vffs/   301
/shop/hayssen/                                   /shop/vffs/   301
/shop/hayssen                                    /shop/vffs/   301

# Renamed part pages (the old ids were published; both were shortened, and the second had been cut off
# mid-word). Part ids are public URLs: see "Catalog data" in README.md before renaming another one.
# These go straight to the final /shop/vffs/ URL (one redirect, not two) and come before the placeholder
# and splat rules that move the rest of the old catalog path.
/shop/hayssen-vffs/actuator/03025b7031-stainless-steel-pivot-link-6-3-8in-center-to-center-of-hole/   /shop/vffs/actuator/03025b7031-stainless-steel-pivot-link-6-3-8in-center-to-center/   301
/shop/hayssen-vffs/actuator/03025b7031-stainless-steel-pivot-link-6-3-8in-center-to-center-of-hole    /shop/vffs/actuator/03025b7031-stainless-steel-pivot-link-6-3-8in-center-to-center/   301
/shop/hayssen-vffs/actuator/03026e1891-stainless-steel-shaft-for-jaw-carrier-1in-x-26-875-long-wit/   /shop/vffs/actuator/03026e1891-stainless-steel-shaft-for-jaw-carrier-1in-x-26-875-long/   301
/shop/hayssen-vffs/actuator/03026e1891-stainless-steel-shaft-for-jaw-carrier-1in-x-26-875-long-wit    /shop/vffs/actuator/03026e1891-stainless-steel-shaft-for-jaw-carrier-1in-x-26-875-long/   301

# The parts catalog moved from the old machine path to /shop/vffs/ (part, section and hub URLs keep
# their ids, so the rest of the path carries over: see the splat rule under "Wildcards last").
/shop/hayssen-vffs     /shop/vffs/   301
/shop/hayssen-vffs/    /shop/vffs/   301

# Old section and part URLs requested WITHOUT a trailing slash: send them straight to the slash form so
# the visitor gets one 301 and then the page (the splat rule alone would be followed by a second redirect
# from Cloudflare's trailing-slash handling). The renamed ids above come first.
/shop/hayssen-vffs/:section/:slug    /shop/vffs/:section/:slug/   301
/shop/hayssen-vffs/:section          /shop/vffs/:section/         301

