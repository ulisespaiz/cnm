{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  // Static site served from Workers Static Assets: no Worker script, no
  // Astro adapter. Pages are pre-rendered by `astro build` into ./dist.
  "name": "cnmwebsite",
  "compatibility_date": "2026-10-06",
  // Runs before `wrangler deploy`, so the deploy works even if the
  // Cloudflare dashboard has no build command set.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
